<UserControl x:Class="FalconBMS.Launcher.Controls.AxisBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FalconBMS.Launcher.Converters"
             x:Name="root">

    <UserControl.Resources>
        <conv:FractionToCanvasLeftConverter x:Key="FractionToCanvasLeftConverter"/>
    </UserControl.Resources>

    <!--
      Reusable WPF control that draws the live axis bar, labels, and marker positions for axis assignment and monitoring.
      Used in BOTH places:
      - AxisAssignWindow (with labels)
      - Tabs (without labels)
      ShowLabels defaults to True so the popup stays as-is.
    -->

    <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Left"
                   Width="100"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   TextAlignment="Right"
                   Text="{Binding LeftLabel, ElementName=root}"
                   Margin="0,0,10,0"
                   Visibility="{Binding ShowLabels, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <TextBlock DockPanel.Dock="Right"
                   Width="100"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   TextAlignment="Left"
                   Text="{Binding RightLabel, ElementName=root}"
                   Margin="10,0,0,0"
                   Visibility="{Binding ShowLabels, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Grid Width="{Binding BarWidth, ElementName=root}"
              Height="16"
              VerticalAlignment="Center">

            <ProgressBar Height="16"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Value, ElementName=root}"
                         IsEnabled="{Binding IsActive, ElementName=root}"
                         Foreground="{Binding FillBrush, ElementName=root}"
                         VerticalAlignment="Center"/>

            <!-- Detent markers (Throttle only) -->
            <Canvas Height="16"
                    Width="{Binding BarWidth, ElementName=root}"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowDetentMarkersVisibility, ElementName=root}">

                <!-- IDLE marker -->
                <Line Stroke="{Binding IdleDetentBrush, ElementName=root}"
                      StrokeThickness="2"
                      X1="0" X2="0" Y1="0" Y2="16"
                      SnapsToDevicePixels="True">
                    <Line.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource FractionToCanvasLeftConverter}"
                                              ConverterParameter="1">
                                    <Binding ElementName="root" Path="IdleDetentFraction"/>
                                    <Binding ElementName="root" Path="BarWidth"/>
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Line.RenderTransform>
                </Line>

                <!-- AB marker -->
                <Line Stroke="{Binding AbDetentBrush, ElementName=root}"
                      StrokeThickness="2"
                      X1="0" X2="0" Y1="0" Y2="16"
                      SnapsToDevicePixels="True">
                    <Line.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource FractionToCanvasLeftConverter}"
                                              ConverterParameter="1">
                                    <Binding ElementName="root" Path="AbDetentFraction"/>
                                    <Binding ElementName="root" Path="BarWidth"/>
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Line.RenderTransform>
                </Line>

            </Canvas>

            <TextBlock Text="{Binding OverlayText, ElementName=root}"
                       Visibility="{Binding OverlayVisibility, ElementName=root}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Width="{Binding BarWidth, ElementName=root}"
                       TextAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>