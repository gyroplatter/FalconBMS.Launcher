<Window x:Class="FalconBMS.Launcher.Views.LegacyImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Existing Controls"
        Width="650"
        Height="560"
        MinWidth="650"
        MinHeight="500"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="Existing Controls"/>

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,18"
                   TextWrapping="Wrap" 
                   Style="{StaticResource BodyTextBlockStyle}"
                   Text="The old Launcher control files listed below will be imported into the new Launcher. A backup will be made of your original control files."/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>
                <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Style="{StaticResource DialogSectionLabelStyle}"
                       Text="Keyboard files"/>

                <ItemsControl x:Name="KeyboardFilesList"
                       Margin="12,0,0,0">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="{Binding AircraftName}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock FontSize="16"
                       Padding="0,20,0,0"
                       FontWeight="SemiBold"
                       Style="{StaticResource DialogSectionLabelStyle}"
                       Text="Device files"/>

                <ItemsControl x:Name="DevicesList"
                        Margin="12,0,0,0">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Text="{Binding DeviceName}"/>

                                <TextBlock Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Text="{Binding StatusText}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="WarningsPanel"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Style="{StaticResource DialogSectionLabelStyle}"
                               Text="Warnings"/>

                    <ItemsControl x:Name="WarningsList"
                                  Margin="12,8,0,0">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,8"
                                           TextWrapping="Wrap"
                                           Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Margin="0,22,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="110"
                    Height="34"
                    Margin="0,0,10,0"
                    Content="Back"
                    Click="BackButton_Click"/>

            <Button Width="150"
                    Height="34"
                    IsDefault="True"
                    Style="{StaticResource TertiaryButtonStyle}" 
                    Content="Continue Import"
                    Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>