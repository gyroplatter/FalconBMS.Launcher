<UserControl x:Class="FalconBMS.Launcher.Views.ViewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
              Style="{StaticResource ViewContentRootStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Views"
           Style="{StaticResource HeadingTextBlockStyle}"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1"
                    Padding="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                <StackPanel>

                    <CheckBox Content="Use Roll Axis for Steering while on the Ground enabling NWS"
                              IsChecked="{Binding UseRollAxisForNws, Mode=TwoWay}"
                              Margin="0,0,0,14"/>

                    <TextBlock Text="TrackIR Mode"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <StackPanel Margin="16,0,0,14">
                        <RadioButton Content="Head Forward"
                                     GroupName="TrackIrMode"
                                     IsChecked="{Binding IsTrackIrHeadForward, Mode=TwoWay}"
                                     Margin="0,0,0,6"/>

                        <RadioButton Content="Zoom FOV"
                                     GroupName="TrackIrMode"
                                     IsChecked="{Binding IsTrackIrZoomFov, Mode=TwoWay}"/>

                    </StackPanel>

                    <CheckBox Content="External MouseLook"
                              IsChecked="{Binding ExternalMouseLook, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Natural Head Movement"
                              IsChecked="{Binding NaturalHeadMovement, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Pilot Model"
                              IsChecked="{Binding PilotModel, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="Smart Scaling"
                              IsChecked="{Binding SmartScalingEnabled, Mode=TwoWay}"/>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>