<UserControl x:Class="FalconBMS.Launcher.Views.ViewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
              Style="{StaticResource ViewContentRootStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <CheckBox Content="Use Roll Axis for Steering while on the Ground"
                              IsChecked="{Binding UseRollAxisForNws, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="When enabled, moving the stick left or right will cause the nose wheel to turn when the aircraft is on the ground. This option disables the yaw axis."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="TrackIR Mode"
                               Style="{StaticResource SubheadingTextBlockStyle}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Choose how TrackIR/head-tracking forward movement is interpreted."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <RadioButton Content="Head Forward"
                                 GroupName="TrackIrMode"
                                 IsChecked="{Binding IsTrackIrHeadForward, Mode=TwoWay}"
                                 Margin="0,0,0,6"/>

                    <TextBlock Text="Uses forward/backward head movement as a direct forward/backward head position movement."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="20,0,0,10"/>

                    <RadioButton Content="Zoom FOV"
                                 GroupName="TrackIrMode"
                                 IsChecked="{Binding IsTrackIrZoomFov, Mode=TwoWay}"
                                 Margin="0,0,0,6"/>

                    <TextBlock Text="Uses forward head movement to adjust the field of view, creating a zoom effect when you lean in."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <CheckBox Content="External Mouse Look"
                              IsChecked="{Binding ExternalMouseLook, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Allows the mouse to control the camera in external views."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="When this is enabled, the POV hat will no longer control the external camera view."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <CheckBox Content="Natural Head Movement"
                              IsChecked="{Binding NaturalHeadMovement, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Makes rearward head movement feel more realistic when looking behind you."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="When looking back toward your six o'clock position, this settings accounts for the natural torso movement needed to turn your head that far. This works with or without a head-tracking device."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <CheckBox Content="Pilot Model"
                              IsChecked="{Binding PilotModel, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Shows the pilot body inside the 3D cockpit."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="This includes the visible pilot model and kneeboards while flying from the cockpit view."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <CheckBox Content="Smart Scaling"
                              IsChecked="{Binding SmartScalingEnabled, Mode=TwoWay}"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Makes distant aircraft easier to see and identify during visual-range combat."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Real-world pilots can see small aircraft details from far away that are often lost on monitors. Smart Scaling helps compensate for this by slightly enlarging distant targets so their pitch, bank, heading, and orientation are easier to judge."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="The effect is minimal at close range and increases at longer visual ranges, helping improve target orientation without making nearby aircraft look unnaturally large."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>