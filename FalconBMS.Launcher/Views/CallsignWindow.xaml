<Window x:Class="FalconBMS.Launcher.Views.CallsignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Pilot"
        Width="460"
        Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="DashboardTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SubheadingTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DashboardSectionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16"
          Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Register Pilot"
                   Style="{StaticResource DashboardTitleStyle}"
                   Margin="0,0,0,14"/>

        <TextBlock Grid.Row="1"
                   Text="Callsign"
                   Style="{StaticResource DashboardSectionLabelStyle}"/>

        <TextBox Grid.Row="2"
                 x:Name="TextBox_Callsign"
                 Text="Viper"
                 MaxLength="12"
                 Margin="0,0,0,4"
                 TextChanged="Callsign_Changed"/>

        <TextBlock Grid.Row="3"
                   x:Name="Label_Error_Callsign"
                   Text="Seriously your callsign is &quot;Viper&quot; !?"
                   Visibility="Collapsed"
                   Foreground="Firebrick"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4"
                   Text="Pilot Name"
                   Style="{StaticResource DashboardSectionLabelStyle}"/>

        <StackPanel Grid.Row="5">
            <TextBox x:Name="TextBox_PilotName"
                     Text="Joe Pilot"
                     MaxLength="20"
                     Margin="0,0,0,4"
                     TextChanged="PilotName_Changed"/>

            <TextBlock x:Name="Label_Error_PilotName"
                       Text="Seriously your name is &quot;Joe Pilot&quot; !?"
                       Visibility="Collapsed"
                       Foreground="Firebrick"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="Register"
                    Width="90"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="Button_Register_Click"/>
        </StackPanel>
    </Grid>
</Window>