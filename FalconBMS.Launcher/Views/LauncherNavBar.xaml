<UserControl x:Class="FalconBMS.Launcher.Views.LauncherNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Style="{StaticResource HeaderNavStackPanelStyle}">
        <Button Content="Main"
                Style="{StaticResource HeaderNavButtonMainStyle}"
                Click="Main_Click"/>

        <Button Content="Controls"
                Style="{StaticResource HeaderNavButtonControlsStyle}"
                Click="Controls_Click"/>

        <Button Content="Display"
                Style="{StaticResource HeaderNavButtonDisplayStyle}"
                Click="Display_Click"/>

        <Button Content="Views"
                Style="{StaticResource HeaderNavButtonViewsStyle}"
                Click="Views_Click"/>

        <Button x:Name="StylesButton"
                Content="Styles"
                Style="{StaticResource HeaderNavButtonStylesStyle}"
                Click="Styles_Click"/>
    </StackPanel>
</UserControl>