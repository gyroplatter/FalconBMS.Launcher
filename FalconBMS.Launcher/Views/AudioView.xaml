<UserControl x:Class="FalconBMS.Launcher.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <!-- This file can be removed later -->
    <!-- This is from start of project when Audio was control from its own tab -->

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Audio"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Padding="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <TextBlock Text="Audio axis assignments have been moved to the Controls tab."
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>