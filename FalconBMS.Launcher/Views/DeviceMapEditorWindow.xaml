<Window x:Class="FalconBMS.Launcher.Views.DeviceMapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1157"
        Height="745"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Device and image heading -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Device:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBlock Text="{Binding DeviceName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Image:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBlock Text="{Binding ImageFileName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <Grid Width="125">

                    <Button Content="Add Image"
            Command="{Binding ChangeImageCommand}">
                        <Button.Style>
                            <Style TargetType="Button"
                   BasedOn="{StaticResource TertiaryButtonStyle}">

                                <Setter Property="Visibility"
                        Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDeviceImage}"
                                 Value="True">
                                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Change Image"
            Command="{Binding ChangeImageCommand}">
                        <Button.Style>
                            <Style TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">

                                <Setter Property="Visibility"
                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDeviceImage}"
                                 Value="True">
                                        <Setter Property="Visibility"
                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                </Grid>

            </StackPanel>
        </Grid>

        <!-- Editor workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Device inputs -->
            <Border Grid.Column="0"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DEVICE INPUTS"
                               Style="{StaticResource ControlsNavHeadingTextBlockStyle}"/>

                    <ListBox x:Name="DeviceInputsListBox"
                             Grid.Row="2"
                             ItemsSource="{Binding Inputs}"
                             SelectedItem="{Binding SelectedInput, Mode=TwoWay}"
                             SelectionChanged="DeviceInputsListBox_SelectionChanged"
                             Style="{StaticResource ControlsNavListBoxStyle}"
                             ItemContainerStyle="{StaticResource ControlsNavListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Margin="8,0,2,0"
                                                VerticalAlignment="Center">

                                        <!-- Assigned -->
                                        <Polygon Width="16"
                                                 Height="16"
                                                 Points="6,0 12,6 6,12 0,6"
                                                 Stretch="Fill"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource DeviceInputAssignedStatusShapeStyle}"/>

                                        <!-- Hotspot -->
                                        <Ellipse Width="12"
                                                 Height="12"
                                                 Margin="7,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource DeviceInputHotspotStatusShapeStyle}"/>

                                    </StackPanel>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <Border Grid.Row="4"
                            Padding="8,6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Background="{DynamicResource AppWindowBackgroundBrush}">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Polygon Width="16"
                                     Height="16"
                                     Points="6,0 12,6 6,12 0,6"
                                     Stretch="Fill"
                                     Fill="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Assigned"
                                       Margin="6,0,12,0"
                                       VerticalAlignment="Center"/>

                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Hotspot"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Border>
                </Grid>

            </Border>

            <!-- Device image and editable hotspots -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>

                    <!--
                        Image and hotspot canvas share one canonical surface.
                        The Viewbox scales that surface without changing its
                        aspect ratio.
                    -->
                    <Viewbox Margin="18"
                             Stretch="Uniform">

                        <Viewbox.Style>
                            <Style TargetType="Viewbox">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasDeviceImage}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>

                        <Grid Width="{Binding MapSurfaceWidth}"
                              Height="{Binding MapSurfaceHeight}">

                            <Image Source="{Binding DeviceImage}"
                                   Stretch="Fill"/>

                            <!-- Curved connectors sit behind hotspots/callouts. -->
                            <ItemsControl ItemsSource="{Binding VisibleConnectors}"
                                          IsHitTestVisible="False">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Path Data="{Binding ConnectorGeometry}"
                                              Stroke="{DynamicResource AppAccentBrush}"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Opacity="0.9"/>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <ItemsControl x:Name="HotspotItemsControl"
                                          ItemsSource="{Binding VisibleHotspots}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">

                                        <Setter Property="Canvas.Left"
                                                Value="{Binding Left}"/>

                                        <Setter Property="Canvas.Top"
                                                Value="{Binding Top}"/>

                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Width="{Binding DisplayWidth}"
                                              Height="{Binding DisplayHeight}"
                                              Cursor="SizeAll"
                                              MouseLeftButtonDown="Hotspot_MouseLeftButtonDown"
                                              MouseMove="Hotspot_MouseMove"
                                              MouseLeftButtonUp="Hotspot_MouseLeftButtonUp">

                                            <Ellipse Fill="{DynamicResource AppAccentBrush}"
                                                     Stroke="{DynamicResource AppAccentBrush}"
                                                     StrokeThickness="3"
                                                     Opacity="0.35"/>

                                            <!-- Top-left resize handle -->
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Margin="-8,-8,0,0"
                                                     Fill="{DynamicResource AppAccentBrush}"
                                                     Stroke="{DynamicResource AppWindowBackgroundBrush}"
                                                     StrokeThickness="2"
                                                     Cursor="SizeNWSE"
                                                     Tag="TopLeft"
                                                     MouseLeftButtonDown="HotspotResize_MouseLeftButtonDown"
                                                     MouseMove="HotspotResize_MouseMove"
                                                     MouseLeftButtonUp="HotspotResize_MouseLeftButtonUp"/>

                                            <!-- Top-right resize handle -->
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Top"
                                                     Margin="0,-8,-8,0"
                                                     Fill="{DynamicResource AppAccentBrush}"
                                                     Stroke="{DynamicResource AppWindowBackgroundBrush}"
                                                     StrokeThickness="2"
                                                     Cursor="SizeNESW"
                                                     Tag="TopRight"
                                                     MouseLeftButtonDown="HotspotResize_MouseLeftButtonDown"
                                                     MouseMove="HotspotResize_MouseMove"
                                                     MouseLeftButtonUp="HotspotResize_MouseLeftButtonUp"/>

                                            <!-- Bottom-left resize handle -->
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Bottom"
                                                     Margin="-8,0,0,-8"
                                                     Fill="{DynamicResource AppAccentBrush}"
                                                     Stroke="{DynamicResource AppWindowBackgroundBrush}"
                                                     StrokeThickness="2"
                                                     Cursor="SizeNESW"
                                                     Tag="BottomLeft"
                                                     MouseLeftButtonDown="HotspotResize_MouseLeftButtonDown"
                                                     MouseMove="HotspotResize_MouseMove"
                                                     MouseLeftButtonUp="HotspotResize_MouseLeftButtonUp"/>

                                            <!-- Bottom-right resize handle -->
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Margin="0,0,-8,-8"
                                                     Fill="{DynamicResource AppAccentBrush}"
                                                     Stroke="{DynamicResource AppWindowBackgroundBrush}"
                                                     StrokeThickness="2"
                                                     Cursor="SizeNWSE"
                                                     Tag="BottomRight"
                                                     MouseLeftButtonDown="HotspotResize_MouseLeftButtonDown"
                                                     MouseMove="HotspotResize_MouseMove"
                                                     MouseLeftButtonUp="HotspotResize_MouseLeftButtonUp"/>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- One shared callout per logical DX/POV input. -->
                            <ItemsControl ItemsSource="{Binding VisibleCallouts}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">

                                        <Setter Property="Canvas.Left"
                                                Value="{Binding Left}"/>

                                        <Setter Property="Canvas.Top"
                                                Value="{Binding Top}"/>

                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Width="{Binding DisplayWidth}"
                                                Height="{Binding DisplayHeight}"
                                                Padding="10,7"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppAccentBrush}"
                                                BorderThickness="2"
                                                Cursor="SizeAll"
                                                MouseLeftButtonDown="Callout_MouseLeftButtonDown"
                                                MouseMove="Callout_MouseMove"
                                                MouseLeftButtonUp="Callout_MouseLeftButtonUp">

                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding MappingDisplay}"
                                                           Style="{StaticResource DeviceMapCalloutMappingTextStyle}"
                                                           TextWrapping="Wrap"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           LineHeight="20"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding InputDisplay}"
                                                           Style="{StaticResource DeviceMapCalloutInputTextStyle}"/>
                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Grid>

                    </Viewbox>

                    <TextBlock Text="Choose an image to begin."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedTextBlockStyle}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasDeviceImage}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

            </Border>

            <!-- Current input -->
            <Border Grid.Column="4"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding DeviceName}"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DeviceSummary}"
                               Style="{StaticResource MutedTextBlockStyle}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="3">

                        <TextBlock Text="Press a button on the device or select an input on the left."
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MutedTextBlockStyle}">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasCurrentInput}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                        <StackPanel VerticalAlignment="Top">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasCurrentInput}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="CURRENT INPUT"
                                       Style="{StaticResource ControlsNavHeadingTextBlockStyle}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding CurrentInputDisplay}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="CURRENT BMS MAPPING"
                                       Style="{StaticResource ControlsNavHeadingTextBlockStyle}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding CurrentBmsMappingDisplay}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="ACTIONS"
                                       Style="{StaticResource ControlsNavHeadingTextBlockStyle}"
                                       Margin="0,0,0,8"/>

                            <Button Content="Add Hotspot"
                                    Margin="0,0,0,8"
                                    Command="{Binding AddHotspotCommand}"/>

                            <Button Content="Add Secondary Hotspot"
                                    Margin="0,0,0,8"
                                    Command="{Binding AddSecondaryHotspotCommand}"/>

                            <Button Content="Clear"
                                    Command="{Binding ClearHotspotsCommand}"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>

            <Button Content="Save Map"
                    Width="110"
                    Style="{StaticResource TertiaryButtonStyle}"
                    Command="{Binding SaveCommand}"/>

        </StackPanel>

    </Grid>
</Window>