<UserControl x:Class="FalconBMS.Launcher.Views.StylesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="536">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
              Background="{DynamicResource AppWindowBackgroundBrush}">
        <StackPanel Background="{DynamicResource AppWindowBackgroundBrush}"
                Style="{StaticResource ViewContentRootStyle}">

            <TextBlock Text="Styles"
           Style="{StaticResource HeadingTextBlockStyle}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Debug-only style guide for previewing launcher UI elements in one place."
                       Margin="0,0,0,12"/>

            <TextBlock Text="Launcher Theme"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <WrapPanel Margin="0,0,0,16">
                <RadioButton Content="Auto"
                             GroupName="LauncherThemeModeFromStyles"
                             IsChecked="{Binding DataContext.Main.LauncherThemeAuto, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                             Margin="0,0,16,8"/>

                <RadioButton Content="Light"
                             GroupName="LauncherThemeModeFromStyles"
                             IsChecked="{Binding DataContext.Main.LauncherThemeLight, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                             Margin="0,0,16,8"/>

                <RadioButton Content="Dark"
                             GroupName="LauncherThemeModeFromStyles"
                             IsChecked="{Binding DataContext.Main.LauncherThemeDark, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                             Margin="0,0,16,8"/>
            </WrapPanel>

            <Border Padding="16"
                    Margin="0,0,0,16"
                    BorderThickness="1"
                    Background="{DynamicResource AppSurfaceBrush}">
                <StackPanel>

                    <TextBlock Text="Typography"
           Style="{StaticResource SubheadingTextBlockStyle}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Heading Example"
           Style="{StaticResource HeadingTextBlockStyle}"
           Margin="0,0,0,6"/>

                    <TextBlock Text="Subheading Example"
           Style="{StaticResource SubheadingTextBlockStyle}"
           Margin="0,0,0,6"/>

                    <TextBlock Text="This is normal body copy using the current shared foreground brush."
           Style="{StaticResource BodyTextBlockStyle}"
           Margin="0,0,0,6"/>

                    <TextBlock Text="Muted/example helper text"
           Style="{StaticResource MutedTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    Margin="0,0,0,16"
                    BorderThickness="1"
                    Background="{DynamicResource AppSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Inputs"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="TextBox"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding SampleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="260"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="ComboBox"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding SampleDropdownItems}"
                              SelectedItem="{Binding SelectedDropdownItem, Mode=TwoWay}"
                              Width="260"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Buttons"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Primary"
                                Margin="0,0,8,0"/>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Secondary"/>
                    </WrapPanel>

                    <TextBlock Text="Checkboxes"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <StackPanel Margin="0,0,0,12">
                        <CheckBox Content="Checked example"
                                  IsChecked="{Binding SampleCheckBox, Mode=TwoWay}"
                                  Margin="0,0,0,6"/>

                        <CheckBox Content="Unchecked example"
                                  IsChecked="{Binding SecondaryCheckBox, Mode=TwoWay}"
                                  Margin="0,0,0,6"/>

                        <CheckBox Content="Disabled example"
                                  IsChecked="True"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock Text="Radio Buttons"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <StackPanel>
                        <RadioButton Content="Option A"
                                     GroupName="StyleGuideRadio"
                                     IsChecked="{Binding RadioOptionA, Mode=TwoWay}"
                                     Margin="0,0,0,6"/>

                        <RadioButton Content="Option B"
                                     GroupName="StyleGuideRadio"
                                     IsChecked="{Binding RadioOptionB, Mode=TwoWay}"
                                     Margin="0,0,0,6"/>

                        <RadioButton Content="Disabled option"
                                     GroupName="StyleGuideRadioDisabled"
                                     IsEnabled="False"
                                     IsChecked="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    BorderThickness="1"
                    Background="{DynamicResource AppSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Layout &amp; Surface Testing"
           Style="{StaticResource SubheadingTextBlockStyle}"
                               Margin="0,0,0,12"/>

                    <Border Padding="12"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Surface Alt Example"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Useful for checking contrast between surface, border, foreground, and accent colors."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>