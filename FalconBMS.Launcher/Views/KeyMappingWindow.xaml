<Window x:Class="FalconBMS.Launcher.Views.KeyMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Mapping"
        Width="650"
        MinHeight="330"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="KeyMappingSectionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="KeyMappingFieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KeyMappingAssignmentValueStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <Border Grid.Row="1"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Keyboard"
                               Style="{StaticResource KeyMappingSectionLabelStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Assigned key:"
                                   Style="{StaticResource KeyMappingFieldLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding KeyboardAssignmentText}"
                                   Style="{StaticResource KeyMappingAssignmentValueStyle}"/>

                        <Button Grid.Column="2"
                                Width="96"
                                Content="Clear Key"
                                Command="{Binding ClearKeyCommand}"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding KeyboardConflictText}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>

                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DX Button"
                               Style="{StaticResource KeyMappingSectionLabelStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Assigned DX:"
                                   Style="{StaticResource KeyMappingFieldLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DxAssignmentText}"
                                   Style="{StaticResource KeyMappingAssignmentValueStyle}"/>

                        <Button Grid.Column="2"
                                Width="96"
                                Content="Clear DX"
                                Command="{Binding ClearDxCommand}"/>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Shift State:"
                                   Style="{StaticResource KeyMappingFieldLabelStyle}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="Unshifted"
                                         GroupName="ShiftState"
                                         IsChecked="{Binding IsUnshifted, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,18,0"/>

                            <RadioButton Content="Shifted"
                                         GroupName="ShiftState"
                                         IsChecked="{Binding IsShifted, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="Trigger:"
                                   Style="{StaticResource KeyMappingFieldLabelStyle}"
                                   Margin="0,0,14,0"/>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="Press"
                                         GroupName="TriggerState"
                                         IsChecked="{Binding IsOnPress, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,18,0"/>

                            <RadioButton Content="Release"
                                         GroupName="TriggerState"
                                         IsChecked="{Binding IsOnRelease, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="{Binding DxConflictText}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>

                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>

                <Button Width="96"
                        Content="Save"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>