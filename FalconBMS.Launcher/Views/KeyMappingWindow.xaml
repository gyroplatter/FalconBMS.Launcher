<Window x:Class="FalconBMS.Launcher.Views.KeyMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Mapping"
        Width="520"
        MinHeight="250"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppSurfaceBrush}">

    <Grid Background="{DynamicResource AppSurfaceBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource AppWindowBackgroundBrush}"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding AssignmentText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForegroundBrush}"/>

                    <TextBlock Text="{Binding ConflictText}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>

                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
                <CheckBox Content="Unshifted"
                          IsChecked="{Binding IsUnshifted, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"/>

                <CheckBox Content="On Press"
                          IsChecked="{Binding IsOnPress, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">

                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Clear Key"
                        Command="{Binding ClearKeyCommand}"/>
                
                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Clear DX"
                        Command="{Binding ClearDxCommand}"/>

                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>

                <Button Width="96"
                        Content="Save"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>