<Window x:Class="FalconBMS.Launcher.Views.KeyMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Mapping"
        Width="650"
        MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText}"
                       Style="{StaticResource DialogTitleTextBlockStyle}"/>

            <Border Grid.Row="1"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Keyboard"
                               Style="{StaticResource DialogSectionLabelStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Assigned key:"
                                   Style="{StaticResource DialogFieldLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding KeyboardAssignmentText}"
                                   Style="{StaticResource DialogAssignmentValueStyle}"/>

                        <Button Grid.Column="2"
                                Width="96"
                                Content="Clear Key"
                                Command="{Binding ClearKeyCommand}"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
           Text="{Binding KeyboardConflictText}"
           Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DialogWarningTextBlockStyle}">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>

                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DX Input"
                               Style="{StaticResource DialogSectionLabelStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Assigned DX:"
                                   Style="{StaticResource DialogFieldLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DxAssignmentText}"
                                   Style="{StaticResource DialogAssignmentValueStyle}"/>

                        <Button Grid.Column="2"
                                Width="96"
                                Content="Clear DX"
                                Command="{Binding ClearDxCommand}"/>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Shift State:"
                                   Style="{StaticResource DialogOptionLabelStyle}"
                                   Margin="0,0,14,0"/>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="Unshifted"
                                         GroupName="ShiftState"
                                         IsChecked="{Binding IsUnshifted, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,18,0"/>

                            <RadioButton Content="Shifted"
                                         GroupName="ShiftState"
                                         IsChecked="{Binding IsShifted, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Trigger:"
                                   Style="{StaticResource DialogOptionLabelStyle}"
                                   Margin="0,0,14,0"/>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton Content="Press"
                                         GroupName="TriggerState"
                                         IsChecked="{Binding IsOnPress, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,18,0"/>

                            <RadioButton Content="Release"
                                         GroupName="TriggerState"
                                         IsChecked="{Binding IsOnRelease, Mode=TwoWay}"
                                         IsEnabled="{Binding IsDxOptionSelectionEnabled}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                       Text="{Binding DxConflictText}"
                       Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                BasedOn="{StaticResource DialogWarningTextBlockStyle}">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>

                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>

                <Button Width="96"
                        Content="Save"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>