<Window x:Class="FalconBMS.Launcher.Views.KeyMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Mapping"
        Width="520"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppSurfaceBrush}">

    <Grid Background="{DynamicResource AppSurfaceBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <TextBox Grid.Row="1"
                     Text="{Binding AssignmentText, Mode=OneWay}"
                     IsReadOnly="True"
                     Height="28"
                     VerticalContentAlignment="Center"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
                <CheckBox Content="Unshifted"
                          IsChecked="{Binding IsUnshifted, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"/>

                <CheckBox Content="On Press"
                          IsChecked="{Binding IsOnPress, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Text="{Binding ConflictText}"
                       Foreground="Red"
                       Margin="0,8,0,0"/>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Clear DX"
                        Command="{Binding ClearDxCommand}"/>

                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Clear Key"
                        Command="{Binding ClearKeyCommand}"/>

                <Button Width="96"
                        Margin="0,0,8,0"
                        Content="Save"
                        Command="{Binding SaveCommand}"/>

                <Button Width="96"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>