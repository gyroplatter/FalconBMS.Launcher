<UserControl x:Class="FalconBMS.Launcher.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
          Style="{StaticResource ViewContentRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top controls card -->
        <Border Grid.Row="0"
                Style="{StaticResource DashboardCardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <TextBlock Text="Profile"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox Width="180"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  DisplayMemberPath="AircraftProfile"
                                  Margin="0,0,16,0"/>

                        <Button Content="Create Map"
                                Width="100"
                                Margin="0,0,8,0"
                                Command="{Binding CreateMapCommand}"/>

                        <Button Content="Edit Map"
                                Width="100"
                                Margin="0,0,8,0"
                                Command="{Binding EditMapCommand}"/>

                        <Button Content="Delete Map"
                                Width="100"
                                Command="{Binding DeleteMapCommand}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Import Map"
                                Width="100"
                                Margin="0,0,8,0"
                                Command="{Binding ImportMapCommand}"/>

                        <Button Content="Export Map"
                                Width="100"
                                Command="{Binding ExportMapCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Select an aircraft profile to view its current control mappings. Devices with a map can show assigned controls directly on the device image."
                           Style="{StaticResource MutedTextBlockStyle}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Devices workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Connected devices -->
            <Border Grid.Column="0"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DEVICES"
                               Style="{StaticResource ControlsNavHeadingTextBlockStyle}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ConnectedDevices}"
                             SelectedItem="{Binding SelectedDeviceItem, Mode=TwoWay}"
                             Style="{StaticResource ControlsNavListBoxStyle}"
                             ItemContainerStyle="{StaticResource ControlsNavListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding VisualLayoutStatus}"
                                               Style="{StaticResource MutedTextBlockStyle}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Device map -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>

                    <!--
                        Match the editor's canonical image surface so the
                        normalized hotspot and callout positions render in
                        exactly the same locations.
                    -->
                    <Viewbox Margin="18"
                             Stretch="Uniform">

                        <Viewbox.Style>
                            <Style TargetType="Viewbox">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasSelectedDeviceImage}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>

                        <Grid Width="{Binding MapSurfaceWidth}"
                              Height="{Binding MapSurfaceHeight}">

                            <Image Source="{Binding SelectedDeviceImage}"
                                   Stretch="Fill"/>

                            <!-- Curved lines behind hotspots and callout. -->
                            <ItemsControl ItemsSource="{Binding VisibleConnectors}"
                                          IsHitTestVisible="False">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Path Data="{Binding ConnectorGeometry}"
                                              Stroke="{DynamicResource AppAccentBrush}"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Opacity="0.9"/>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Hotspots for only the last pressed input. -->
                            <ItemsControl ItemsSource="{Binding VisibleHotspots}"
                                          IsHitTestVisible="False">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">

                                        <Setter Property="Canvas.Left"
                                                Value="{Binding Left}"/>

                                        <Setter Property="Canvas.Top"
                                                Value="{Binding Top}"/>

                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Ellipse Width="{Binding DisplayWidth}"
                                                 Height="{Binding DisplayHeight}"
                                                 Fill="{DynamicResource AppAccentBrush}"
                                                 Stroke="{DynamicResource AppAccentBrush}"
                                                 StrokeThickness="3"
                                                 Opacity="0.35"/>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Callout for only the last pressed input. -->
                            <ItemsControl ItemsSource="{Binding VisibleCallouts}"
                                          IsHitTestVisible="False">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">

                                        <Setter Property="Canvas.Left"
                                                Value="{Binding Left}"/>

                                        <Setter Property="Canvas.Top"
                                                Value="{Binding Top}"/>

                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Width="{Binding DisplayWidth}"
                                                Height="{Binding DisplayHeight}"
                                                Padding="10,7"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppAccentBrush}"
                                                BorderThickness="2">

                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding MappingDisplay}"
                                                           Style="{StaticResource DeviceMapCalloutMappingTextStyle}"
                                                           TextWrapping="Wrap"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           LineHeight="20"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding InputDisplay}"
                                                           Style="{StaticResource DeviceMapCalloutInputTextStyle}"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Grid>

                    </Viewbox>

                    <TextBlock Text="No visual layout"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedTextBlockStyle}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasSelectedDeviceImage}"
                                                 Value="True">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

            </Border>

            <!-- Device details -->
            <Border Grid.Column="4"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected device heading -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding SelectedDevice.ProductName}"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource MutedTextBlockStyle}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap">
                        <Run Text="{Binding SelectedDevice.ButtonCount}"/>
                        <Run Text=" buttons, "/>
                        <Run Text="{Binding SelectedDevice.PovCount}"/>
                        <Run Text=" POV, "/>
                        <Run Text="{Binding SelectedDevice.AxisCount}"/>
                        <Run Text=" axes"/>
                    </TextBlock>

                    <Grid Grid.Row="3">

                        <!-- No input captured yet -->
                        <TextBlock Text="Press a button or POV direction on the selected device."
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MutedTextBlockStyle}">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasCurrentInput}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                        <!-- Last pressed input -->
                        <StackPanel VerticalAlignment="Top">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasCurrentInput}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="CURRENT INPUT"
                                       Style="{StaticResource ControlsNavHeadingTextBlockStyle}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding CurrentInputDisplay}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="CURRENT BMS MAPPING"
                                       Style="{StaticResource ControlsNavHeadingTextBlockStyle}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding CurrentBmsMappingDisplay}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>
        </Grid>
    </Grid>
</UserControl>