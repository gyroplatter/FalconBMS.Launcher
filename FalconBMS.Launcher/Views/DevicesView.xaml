<UserControl x:Class="FalconBMS.Launcher.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
          Style="{StaticResource ViewContentRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top controls card -->
        <Border Grid.Row="0"
                Style="{StaticResource DashboardCardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <TextBlock Text="Profile"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox Width="180"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  DisplayMemberPath="AircraftProfile"
                                  Margin="0,0,16,0"/>

                        <Button Content="Create Map"
                                Width="100"
                                Margin="0,0,8,0"/>

                        <Button Content="Edit Map"
                                Width="100"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Import Map"
                                Width="100"
                                Margin="0,0,8,0"/>

                        <Button Content="Export Map"
                                Width="100"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Select an aircraft profile to view its current control mappings. Devices with a visual map can show mapped controls directly on the device image."
                           Style="{StaticResource MutedTextBlockStyle}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Devices workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Connected devices -->
            <Border Grid.Column="0"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DEVICES"
                               Style="{StaticResource ControlsNavHeadingTextBlockStyle}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ConnectedDevices}"
                             SelectedItem="{Binding SelectedDeviceItem, Mode=TwoWay}"
                             Style="{StaticResource ControlsNavListBoxStyle}"
                             ItemContainerStyle="{StaticResource ControlsNavListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Device map -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <!-- DeviceMapRenderer will be added here later. -->

            </Border>

            <!-- Device details -->
            <Border Grid.Column="4"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <!-- Selected-device / mapped-control details will be added later. -->

            </Border>
        </Grid>
    </Grid>
</UserControl>