<UserControl x:Class="FalconBMS.Launcher.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <UserControl.Resources>
        <Style x:Key="DevicesNavHeadingTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DashboardSectionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="DevicesNavListBoxStyle"
               TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="DevicesNavListBoxItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
          Style="{StaticResource ViewContentRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DashboardCardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="False">
                    <TextBlock Text="Profile"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox Width="180"
                              SelectedIndex="0"
                              Margin="0,0,16,0">
                        <ComboBoxItem Content="F-16"/>
                    </ComboBox>

                    <TextBlock Text="Filter"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox Width="260"
                             Margin="0,0,12,0"
                             IsEnabled="False"/>

                    <Button Content="Clear"
                            Width="70"
                            IsEnabled="False"/>
                </DockPanel>

                <TextBlock Grid.Row="2"
                           Text="Select a detected device to view its visual layout. Supported devices can show mapped controls directly on the device image."
                           Style="{StaticResource MutedTextBlockStyle}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="DEVICES"
                               Style="{StaticResource DevicesNavHeadingTextBlockStyle}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DevicesNavListBoxStyle}"
                             ItemContainerStyle="{StaticResource DevicesNavListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource AppForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding TemplateStatus}"
                                               Style="{StaticResource MutedTextBlockStyle}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <!--
                            The image and all visual overlays share the map's canvas size.
                            The Viewbox scales the whole visual together, so map coordinates
                            stay based on the full-sized image, not the on-screen container.
                        -->
                        <Viewbox Stretch="Uniform"
                                 Visibility="{Binding VisualTemplateVisibility}">
                            <Canvas Width="{Binding VisualCanvasWidth}"
                                    Height="{Binding VisualCanvasHeight}">
                                <Image Source="{Binding VisualImageSource}"
                                       Width="{Binding VisualCanvasWidth}"
                                       Height="{Binding VisualCanvasHeight}"
                                       Stretch="Uniform"/>

                                <!-- Active hotspots for the most recently pressed visual control. -->
                                <ItemsControl ItemsSource="{Binding ActiveHotspots}"
                                              Visibility="{Binding ActiveCalloutVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="{Binding Width}"
                                                     Height="{Binding Height}"
                                                     Fill="{DynamicResource AppAccentBrush}"
                                                     Opacity="0.32"
                                                     Stroke="{DynamicResource AppAccentBrush}"
                                                     StrokeThickness="8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Active connector lines for the most recently pressed control.
                                     If a control has multiple hotspots, each hotspot gets its own
                                     line to the single center callout box. -->
                                <ItemsControl ItemsSource="{Binding ActiveConnectors}"
                                              Visibility="{Binding ActiveCalloutVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Geometry}"
                                                  Stroke="{DynamicResource AppAccentBrush}"
                                                  StrokeThickness="3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Opacity="0.9"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    Active single callout box.

                                    This stays inside the same map Canvas as the hotspots and
                                    connector lines, so all positions line up. Only this box is
                                    scaled up so the shared theme text styles remain readable.
                                -->
                                <Border Canvas.Left="{Binding ActiveCalloutX}"
                                        Canvas.Top="{Binding ActiveCalloutY}"
                                        Width="{Binding ActiveCalloutWidth}"
                                        Visibility="{Binding ActiveCalloutVisibility}"
                                        Padding="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AppAccentBrush}"
                                        Background="{DynamicResource AppWindowBackgroundBrush}"
                                        RenderTransformOrigin="0,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ActiveCalloutScale}"
                                                        ScaleY="{Binding ActiveCalloutScale}"/>
                                    </Border.RenderTransform>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ActiveCalloutPhysicalName}"
                                                   Style="{StaticResource DialogAssignmentValueStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ActiveCalloutInputId}"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </Canvas>
                            
                        </Viewbox>

                        <!-- Generic placeholder shown for detected devices without a visual layout yet. -->
                        <Border Visibility="{Binding GenericFallbackVisibility}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                Background="{DynamicResource AppWindowBackgroundBrush}"
                                Padding="24">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="460">
                                <TextBlock Text="No Visual Layout Yet"
                                           Style="{StaticResource SubheadingTextBlockStyle}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="This detected device does not have an image/control layout map yet. The device still comes from the real binding model; only the visual layout is missing."
                                           Style="{StaticResource MutedTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,18"/>

                                <Border Padding="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        Background="{DynamicResource AppSurfaceBrush}">
                                    <TextBlock Text="{Binding DeviceCapabilitiesText}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1"
                            Margin="20,0,0,0"
                            Padding="14"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Background="{DynamicResource AppWindowBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDeviceName}"
                                       d:Text="Joystick - HOTAS Warthog"
                                       Style="{StaticResource SubheadingTextBlockStyle}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding DeviceCapabilitiesText}"
                                       d:Text="19 buttons, 1 POV, 2 axes"
                                       Style="{StaticResource MutedTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,34"/>

                            <!--
                                Devices is not a second mapping editor.
                                This right panel summarizes the mapped Controls row for the selected DX button.
                                Modify opens the existing KeyMappingWindow for that same row.
                            -->
                            <StackPanel Visibility="{Binding MappedControlDetailsVisibility}">
                                <TextBlock Text="{Binding MappedControlDescription}"
                                           d:Text="Pickle Release"
                                           Style="{StaticResource DashboardSectionLabelStyle}"
                                           Margin="0,0,0,32"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Keyboard"
                                           Style="{StaticResource DialogOptionLabelStyle}"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding MappedKeyboardText}"
                                           d:Text="Alt A"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Margin="0,0,0,26"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="DX Button"
                                           Style="{StaticResource DialogOptionLabelStyle}"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding MappedDxButtonText}"
                                           d:Text="DX4"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Margin="0,0,0,28"
                                           TextWrapping="Wrap"/>

                                <Button Content="Modify"
                                        Command="{Binding ModifyMappingCommand}"
                                        Width="110"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>