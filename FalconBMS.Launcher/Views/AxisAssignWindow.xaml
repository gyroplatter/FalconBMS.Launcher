<Window x:Class="FalconBMS.Launcher.Views.AxisAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FalconBMS.Launcher.Views"
        Title="Assign Axis"
        Width="650"
        MinHeight="310"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
      ClipToBounds="True">

        <!-- Background image for all uses of Assign Axis.
         Uses ImageBrush so it does not affect window size. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/background-window-throttle.jpg"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
            </Border.Background>
        </Border>

        <!-- Fade layer. Increase opacity to hide more of the image. -->
        <Border Background="{DynamicResource AppWindowBackgroundBrush}"
            Opacity="0.88"
            IsHitTestVisible="False"/>

        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText}"
                       Style="{StaticResource DialogTitleTextBlockStyle}"/>

            <!--
                Axis assignment stays in one card because the live axis,
                invert state, curve settings, and throttle detents are all
                settings for the same physical axis assignment.
            -->
            <Border Grid.Row="1"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Axis direction labels and live movement bar. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!--
                                Side columns are wide enough for longer labels,
                                but the labels align toward the axis bar so short
                                labels like Back/Forward do not drift away.
                            -->
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding LeftLabel}"
                                   Style="{StaticResource DialogSectionLabelStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,10,0"/>

                        <!--
                            MaxWidth stops the axis bar from taking too much space.
                            It still stretches/shrinks naturally inside the available row.
                        -->
                        <views:AxisBar Grid.Column="1"
                                       Height="18"
                                       MaxWidth="320"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Value="{Binding AxisBarValue, Mode=OneWay}"
                                       IsActive="{Binding HasLiveAxis}"
                                       ShowDetents="{Binding ShowThrottleDetents}"
                                       IdleDetentFraction="{Binding IdleDetentFraction}"
                                       AfterburnerDetentFraction="{Binding AfterburnerDetentFraction}"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding RightLabel}"
                                   Style="{StaticResource DialogSectionLabelStyle}"
                                   HorizontalAlignment="Left"
                                   Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Current assignment / awaiting-input status. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70*"/>
                            <ColumnDefinition Width="117*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Assigned axis:"
                                   Style="{StaticResource DialogFieldLabelStyle}" Margin="0,0,14,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource DialogAssignmentValueStyle}"
                                   Margin="0,0,16,0" Grid.ColumnSpan="2"/>

                        <Button Grid.Column="3"
                                Content="Clear"
                                Width="96"
                                Command="{Binding ClearCommand}"/>
                    </Grid>

                    <!--
                        Match keyboard-mapping behavior: warn before Save when this physical axis
                        is already assigned elsewhere. Save is still allowed and will replace
                        the previous assignment.
                    -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding ConflictText}"
                               Visibility="{Binding HasAxisConflict, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource DialogWarningTextBlockStyle}"
                               Margin="0,10,0,0"/>

                    <Border Grid.Row="5"
                            Height="1"
                            Background="{DynamicResource AppBorderBrush}"/>

                    <!--
                        Invert remains separate because it reverses the entire axis.
                        Deadzone, Saturation, and throttle points are tuning controls.
                    -->
                    <CheckBox Grid.Row="7"
                              Content="Invert"
                              IsChecked="{Binding Invert, Mode=TwoWay}"
                              Visibility="{Binding InvertVisibility}"
                              HorizontalAlignment="Left"
                              Foreground="{DynamicResource AppForegroundBrush}"
                              FontWeight="Bold"
                              Margin="0"/>

                    <!--
                        WrapPanel lets the same row handle all three axis layouts:
                        - Deadzone + Saturation
                        - Saturation only
                        - Saturation + Idle Cutoff + Afterburner Point

                        Collapsed controls are removed from the flow, so Saturation
                        moves left when Deadzone is not supported.
                    -->
                    <WrapPanel Grid.Row="9"
                               Orientation="Horizontal">

                        <StackPanel Width="150"
                                    Margin="0,0,24,0"
                                    Visibility="{Binding DeadzoneVisibility}">
                            <TextBlock Text="Deadzone"
                                       Style="{StaticResource DialogOptionLabelStyle}"/>

                            <ComboBox Width="150"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding AxisCurveOptions}"
                                      SelectedItem="{Binding DeadzoneCurve, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Width="150"
                                    Margin="0,0,64,0"
                                    Visibility="{Binding SaturationVisibility}">
                            <TextBlock Text="Saturation"
                                       Style="{StaticResource DialogOptionLabelStyle}"/>

                            <ComboBox Width="150"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding AxisCurveOptions}"
                                      SelectedItem="{Binding SaturationCurve, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Width="300"
            Visibility="{Binding ThrottleDetentVisibility}">
                            <TextBlock Text="Throttle Detents"
               Style="{StaticResource DialogOptionLabelStyle}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Set Idle Cutoff"
                Width="138"
                Margin="0,0,24,0"
                Command="{Binding SetIdleDetentCommand}"/>

                                <Button Content="Set Afterburner"
                Width="138"
                Command="{Binding SetAfterburnerDetentCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <!--
                Axis sharing notice: BMS currently uses one shared axismapping.dat table
                for all aircraft, so an axis edited here from the F-15 profile also affects
                F-16. ShowsSharedAxisNotice is only true when this popup was opened from the
                F-15 profile, so the F-16 workflow is unaffected.
            -->
            <TextBlock Grid.Row="2"
                       Text="Axes are currently shared between the F-16 and F-15. Changing this axis here will also change it for your F-16 controls."
                       Visibility="{Binding ShowsSharedAxisNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       Margin="0,16,0,0"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                
                <Button Content="Cancel"
                        Width="96"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Save"
                        Width="96"
                        IsDefault="True"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>