<Window x:Class="FalconBMS.Launcher.Views.AxisAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FalconBMS.Launcher.Views"
        Title="Assign Axis"
        Width="560"
        MinHeight="310"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppSurfaceBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="18"
          Background="{DynamicResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding TitleText}"
                   FontSize="{StaticResource FontSizeLarge}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppForegroundBrush}"
                   Margin="6,0,0,8"/>

        <Grid Grid.Row="1"
              Margin="6,0,6,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
           Text="{Binding LeftLabel}"
           HorizontalAlignment="Right"
           VerticalAlignment="Center"
           Margin="0,0,8,0"
           Foreground="{DynamicResource AppForegroundBrush}"/>

            <!--
            Keep the axis bar visible in the assignment window even before an axis is mapped.
            The AxisBar control always draws its outline; IsActive only controls whether the
            live fill is active. This lets the user see the target bar immediately while
            still preserving blank unmapped cells in the main keymapping table.
            -->
            <views:AxisBar Grid.Column="1"
               Height="18"
               VerticalAlignment="Center"
               Value="{Binding AxisBarValue, Mode=OneWay}"
               IsActive="{Binding HasLiveAxis}"
               ShowDetents="{Binding ShowThrottleDetents}"
               IdleDetentFraction="{Binding IdleDetentFraction}"
               AfterburnerDetentFraction="{Binding AfterburnerDetentFraction}"/>

            <TextBlock Grid.Column="2"
           Text="{Binding RightLabel}"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Margin="8,0,0,0"
           Foreground="{DynamicResource AppForegroundBrush}"/>
        </Grid>

        <Border Grid.Row="2"
        BorderBrush="{DynamicResource AppBorderBrush}"
        BorderThickness="1"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        CornerRadius="4"
        Padding="10"
        Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppForegroundBrush}"/>

                <!--
        Match keyboard-mapping behavior: warn before Save when this physical axis
        is already assigned elsewhere. Save is still allowed and will replace
        the previous assignment.
        -->
                <TextBlock Text="{Binding ConflictText}"
                   Visibility="{Binding HasAxisConflict, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!--
        Keep option controls in normal document flow.
        Do not use absolute bottom alignment here; throttle rows need room for
        Invert, Saturation, and detent buttons without overlapping Save/Cancel.
        -->
        <StackPanel Grid.Row="3"
                    Orientation="Vertical">

            <CheckBox Content="Invert"
                      IsChecked="{Binding Invert, Mode=TwoWay}"
                      Visibility="{Binding InvertVisibility}"
                      Foreground="{DynamicResource AppForegroundBrush}"
                      Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            Visibility="{Binding DeadzoneVisibility}">
                    <TextBlock Text="DeadZone"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="120"
                              ItemsSource="{Binding AxisCurveOptions}"
                              SelectedItem="{Binding DeadzoneCurve, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Vertical"
                            Visibility="{Binding SaturationVisibility}">
                    <TextBlock Text="Saturation"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="120"
                              ItemsSource="{Binding AxisCurveOptions}"
                              SelectedItem="{Binding SaturationCurve, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding ThrottleDetentVisibility}">
                    <Button Content="Idle Detent"
                            Width="100"
                            Margin="0,0,10,0"
                            Command="{Binding SetIdleDetentCommand}"/>
                    <Button Content="AB Detent"
                            Width="100"
                            Command="{Binding SetAfterburnerDetentCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Clear"
                    Width="90"
                    Margin="0,0,10,0"
                    Command="{Binding ClearCommand}"/>
            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Save"
                    Width="90"
                    IsDefault="True"
                    Style="{StaticResource TertiaryButtonStyle}" 
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>