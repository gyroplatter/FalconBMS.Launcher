<Window x:Class="FalconBMS.Launcher.Views.AxisAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Axis"
        Width="520"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppSurfaceBrush}">

    <Grid Margin="18"
          Background="{DynamicResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="Assign Axis"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppForegroundBrush}"
                   Margin="6,0,0,8"/>

        <Grid Grid.Row="1"
              Margin="6,0,6,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LeftLabelTextBlock"
                       Grid.Column="0"
                       Text=""
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource AppForegroundBrush}"/>

            <Grid Grid.Column="1"
                  Height="16"
                  VerticalAlignment="Center">
                <ProgressBar x:Name="AxisProgressBar"
                             Minimum="0"
                             Maximum="1"
                             Value="0.5"
                             Height="16"/>

                <Canvas x:Name="ThrottleMarkerCanvas"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Rectangle Width="2"
                               Height="16"
                               Fill="Red"
                               Canvas.Left="34"/>
                    <Rectangle Width="2"
                               Height="16"
                               Fill="LimeGreen"
                               Canvas.Left="190"/>
                </Canvas>
            </Grid>

            <TextBlock x:Name="RightLabelTextBlock"
                       Grid.Column="2"
                       Text=""
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="{DynamicResource AppForegroundBrush}"/>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource AppWindowBackgroundBrush}"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,22">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Awaiting inputs"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppForegroundBrush}"/>
        </Border>

        <Grid Grid.Row="3">
            <CheckBox x:Name="InvertCheckBox"
                      Content="Invert"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,44"
                      Foreground="{DynamicResource AppForegroundBrush}"/>

            <StackPanel x:Name="DeadzonePanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,0">
                <TextBlock Text="DeadZone"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="DeadzoneComboBox"
                          Width="120"
                          SelectedIndex="0"/>
            </StackPanel>

            <StackPanel x:Name="SaturationPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="138,0,0,0">
                <TextBlock Text="Saturation"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="SaturationComboBox"
                          Width="120"
                          SelectedIndex="0"/>
            </StackPanel>

            <StackPanel x:Name="ThrottleDetentPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,0"
                        Visibility="Collapsed">
                <Button Content="Idle Detent"
                        Width="90"
                        Margin="0,0,10,0"/>
                <Button Content="AB Detent"
                        Width="90"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Clear"
                    Width="90"
                    Margin="0,0,10,0"/>
            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
            <Button Content="Save"
                    Width="90"/>
        </StackPanel>
    </Grid>
</Window>