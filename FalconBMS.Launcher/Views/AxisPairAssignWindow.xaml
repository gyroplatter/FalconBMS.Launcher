<Window x:Class="FalconBMS.Launcher.Views.AxisPairAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Assign Axis Pair"
        Width="965"
        Height="625"
        MinWidth="965"
        MinHeight="625"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding PairDefinition.DisplayName}"
                       Style="{StaticResource DialogTitleTextBlockStyle}"
                       Margin="0,0,0,14"/>

            <Border Grid.Row="1"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left side: live X/Y graph for the physical control. -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Canvas x:Name="AxisPairPlotCanvas"
                                Grid.Row="0"
                                Height="380"
                                Margin="0"
                                ClipToBounds="False"
                                SizeChanged="AxisPairPlotCanvas_SizeChanged">

                            <!-- Design-time placeholder only.
                                 Runtime graph drawing happens in AxisPairAssignWindow.xaml.cs.
                                 The code-behind clears AxisPairPlotCanvas.Children before drawing. -->
                            <Grid Width="430"
                                  Height="360"
                                  Canvas.Left="15"
                                  Canvas.Top="10"
                                  Visibility="Collapsed"
                                  d:Visibility="Visible">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Up"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Left"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="Right"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Down"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Canvas Grid.Row="1"
                                        Grid.Column="1"
                                        Width="300"
                                        Height="300"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <Border Width="300"
                                            Height="300"
                                            Background="{DynamicResource AppSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AppAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"/>

                                    <Line X1="75" Y1="0" X2="75" Y2="300"
                                          Stroke="{DynamicResource AppMutedForegroundBrush}"
                                          StrokeThickness="0.7"
                                          Opacity="0.35"/>

                                    <Line X1="225" Y1="0" X2="225" Y2="300"
                                          Stroke="{DynamicResource AppMutedForegroundBrush}"
                                          StrokeThickness="0.7"
                                          Opacity="0.35"/>

                                    <Line X1="0" Y1="75" X2="300" Y2="75"
                                          Stroke="{DynamicResource AppMutedForegroundBrush}"
                                          StrokeThickness="0.7"
                                          Opacity="0.35"/>

                                    <Line X1="0" Y1="225" X2="300" Y2="225"
                                          Stroke="{DynamicResource AppMutedForegroundBrush}"
                                          StrokeThickness="0.7"
                                          Opacity="0.35"/>

                                    <Line X1="150" Y1="0" X2="150" Y2="300"
                                          Stroke="{DynamicResource AppMutedForegroundBrush}"
                                          StrokeThickness="1.2"
                                          Opacity="0.85"/>

                                    <Line X1="0" Y1="150" X2="300" Y2="150"
                                          Stroke="{DynamicResource AppMutedForegroundBrush}"
                                          StrokeThickness="1.2"
                                          Opacity="0.85"/>

                                    <Ellipse Width="54"
                                             Height="54"
                                             Canvas.Left="123"
                                             Canvas.Top="123"
                                             Fill="{DynamicResource AppMutedForegroundBrush}"
                                             Stroke="{DynamicResource AppAccentBrush}"
                                             StrokeThickness="1.2"
                                             Opacity="0.35"/>

                                    <Line X1="142" Y1="150" X2="158" Y2="150"
                                          Stroke="{DynamicResource AppAccentBrush}"
                                          StrokeThickness="1.8"/>

                                    <Line X1="150" Y1="142" X2="150" Y2="158"
                                          Stroke="{DynamicResource AppAccentBrush}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Grid>
                        </Canvas>

                        <Border Grid.Row="2"
                                Margin="0,6,0,0"
                                Padding="0,6,0,0">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Ellipse Width="11"
                                         Height="11"
                                         Stroke="{DynamicResource AppAccentBrush}"
                                         StrokeThickness="1.2"
                                         Fill="{DynamicResource AppForegroundBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>

                                <TextBlock Text="Actual position"
                                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,24,0"/>

                                <TextBlock Text="+"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>

                                <TextBlock Text="In-game position"
                                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,24,0"/>

                                <Ellipse Width="18"
                                         Height="18"
                                         Fill="{DynamicResource AppMutedForegroundBrush}"
                                         Opacity="0.70"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>

                                <TextBlock Text="Deadzone"
                                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1"
                            Width="1"
                            Background="{DynamicResource AppBorderBrush}"/>

                    <!-- Right side: two logical BMS axes edited as one axis pair. -->
                    <Grid Grid.Column="2"
                          Margin="18,0,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Primary axis section -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding Primary.TitleText}"
                                       Style="{StaticResource DialogSectionLabelStyle}"
                                       FontSize="18"
                                       Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="Assigned axis:"
                                           Style="{StaticResource DialogFieldLabelStyle}"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="{Binding Primary.StatusText}"
                                           Style="{StaticResource DialogAssignmentValueStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding Primary.MapButtonText}"
                                        d:Content="Map Pitch"
                                        Height="32"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding MapPrimaryCommand}"/>

                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Height="32"
                                        Command="{Binding ClearPrimaryCommand}"/>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Text="{Binding Primary.ConflictText}"
                                       Visibility="{Binding Primary.HasAxisConflict, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{StaticResource DialogWarningTextBlockStyle}"
                                       Margin="0,8,0,0"/>

                            <Grid Grid.Row="4"
                                  Margin="0,12,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0"
                                          Content="Invert"
                                          IsChecked="{Binding Primary.Invert, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          FontWeight="Bold"
                                          Margin="0,0,0,12"/>

                                <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <StackPanel Width="116"
                                       Margin="0,0,18,0">
                                        <TextBlock Text="Deadzone"
                                            Style="{StaticResource DialogOptionLabelStyle}"/>

                                        <ComboBox Width="116"
                                          ItemsSource="{Binding AxisCurveOptions}"
                                          SelectedItem="{Binding Primary.DeadzoneCurve, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Width="116">
                                        <TextBlock Text="Saturation"
                                            Style="{StaticResource DialogOptionLabelStyle}"/>

                                        <ComboBox Width="116"
                                          ItemsSource="{Binding AxisCurveOptions}"
                                          SelectedItem="{Binding Primary.SaturationCurve, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Secondary axis section -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding Secondary.TitleText}"
                                       Style="{StaticResource DialogSectionLabelStyle}"
                                       FontSize="18"
                                       Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="Assigned axis:"
                                           Style="{StaticResource DialogFieldLabelStyle}"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="{Binding Secondary.StatusText}"
                                           Style="{StaticResource DialogAssignmentValueStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding Secondary.MapButtonText}"
                                        d:Content="Map Pitch"
                                        Height="32"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding MapSecondaryCommand}"/>

                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Height="32"
                                        Command="{Binding ClearSecondaryCommand}"/>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Text="{Binding Secondary.ConflictText}"
                                       Visibility="{Binding Secondary.HasAxisConflict, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{StaticResource DialogWarningTextBlockStyle}"
                                       Margin="0,8,0,0"/>

                            <Grid Grid.Row="4"
                                  Margin="0,12,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0"
                                          Content="Invert"
                                          IsChecked="{Binding Secondary.Invert, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          FontWeight="Bold"
                                          Margin="0,0,0,12"/>

                                <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <StackPanel Width="116"
                                        Margin="0,0,18,0">
                                        <TextBlock Text="Deadzone"
                                             Style="{StaticResource DialogOptionLabelStyle}"/>

                                        <ComboBox Width="116"
                                          ItemsSource="{Binding AxisCurveOptions}"
                                          SelectedItem="{Binding Secondary.DeadzoneCurve, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Width="116">
                                        <TextBlock Text="Saturation"
                                            Style="{StaticResource DialogOptionLabelStyle}"/>

                                        <ComboBox Width="116"
                                          ItemsSource="{Binding AxisCurveOptions}"
                                          SelectedItem="{Binding Secondary.SaturationCurve, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Cancel"
                        Width="96"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Save"
                        Width="96"
                        IsDefault="True"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>