<Window x:Class="FalconBMS.Launcher.Views.AxisPairAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding PairDefinition.WindowTitle}"
        Width="1200"
        MinWidth="1200"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="AxisPairPercentageSliderStyle"
               TargetType="Slider">
            <Setter Property="Minimum"
                    Value="0"/>
            <Setter Property="Maximum"
                    Value="3"/>
            <Setter Property="TickFrequency"
                    Value="1"/>
            <Setter Property="IsSnapToTickEnabled"
                    Value="True"/>
            <Setter Property="IsMoveToPointEnabled"
                    Value="True"/>
            <Setter Property="AutoToolTipPlacement"
                    Value="None"/>
            <Setter Property="Height"
                    Value="24"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="AxisPairPercentageTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource AppMutedForegroundBrush}"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding PairDefinition.DisplayName}"
                       Style="{StaticResource DialogTitleTextBlockStyle}"
                       Margin="0,0,0,14"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Large combined live X/Y display. -->
                <Border Grid.Column="0"
                    Padding="18">

                    <Border.Style>
                        <Style TargetType="Border"
               BasedOn="{StaticResource DashboardCardStyle}">

                            <Setter Property="VerticalAlignment"
                    Value="Stretch"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondaryAxis}"
                             Value="False">

                                    <Setter Property="VerticalAlignment"
                            Value="Top"/>

                                    <Setter Property="Height"
                            Value="{Binding ElementName=PrimaryAxisCard,
                                            Path=ActualHeight}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Text="{Binding PairDefinition.PlotTitle}"
                           Style="{StaticResource DialogSectionLabelStyle}"
                           Foreground="{DynamicResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           Margin="0,0,0,8"/>

                        <Canvas x:Name="AxisPairPlotCanvas"
                            Grid.Row="1"
                            ClipToBounds="False"
                            SizeChanged="AxisPairPlotCanvas_SizeChanged">

                            <Canvas.Style>
                                <Style TargetType="Canvas">
                                    <Setter Property="MinHeight"
                    Value="470"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSecondaryAxis}"
                             Value="False">
                                            <Setter Property="MinHeight"
                            Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Canvas.Style>
                        </Canvas>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">

                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{DynamicResource AppForegroundBrush}"
                                     Stroke="{DynamicResource AppAccentBrush}"
                                     StrokeThickness="1.2"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>

                            <TextBlock Text="Actual position"
                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,28,0"/>

                            <Grid Width="18"
                                  Height="18"
                                  VerticalAlignment="Center"
                                  Margin="0,0,7,0">
                                <Rectangle Width="4"
                                           Height="18"
                                           Fill="{DynamicResource AppAccentBrush}"
                                           HorizontalAlignment="Center"/>
                                <Rectangle Width="18"
                                           Height="4"
                                           Fill="{DynamicResource AppAccentBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="In-game position"
                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Separate axes controls -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Primary Axis -->
                    <Border x:Name="PrimaryAxisCard"
                        Grid.Row="0"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Primary.TitleText}"
                                           Style="{StaticResource DialogSectionLabelStyle}"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="18"
                                           Margin="0,0,0,10"/>

                                <Grid Grid.Row="1"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Assigned axis:"
                                               Style="{StaticResource DialogFieldLabelStyle}"
                                               Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Primary.StatusText}"
                                               Style="{StaticResource DialogAssignmentValueStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Button Grid.Row="2"
                                        Content="{Binding Primary.MapButtonText}"
                                        Width="146"
                                        HorizontalAlignment="Left"
                                        Command="{Binding MapPrimaryCommand}"
                                        Margin="0,0,0,12"/>

                                <CheckBox Grid.Row="3"
                                          Content="Invert"
                                          IsChecked="{Binding Primary.Invert, Mode=TwoWay}"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,12"/>

                                <Grid Grid.Row="4"
      Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Pitch deadzone. -->
                                    <Grid Grid.Row="0"
          Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="Deadzone"
                   Style="{StaticResource DialogOptionLabelStyle}"
                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
                Style="{StaticResource AxisPairPercentageSliderStyle}"
                Margin="8,0,10,0"
                Value="{Binding Primary.DeadzoneStep,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                                        <Border Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="5,2"
                CornerRadius="2"
                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Primary.DeadzonePercentageText}"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Pitch saturation. -->
                                    <Grid Grid.Row="1"
          Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="Saturation"
                   Style="{StaticResource DialogOptionLabelStyle}"
                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
                Style="{StaticResource AxisPairPercentageSliderStyle}"
                Margin="8,0,10,0"
                Value="{Binding Primary.SaturationStep,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                                        <Border Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="5,2"
                CornerRadius="2"
                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Primary.SaturationPercentageText}"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Pitch curve. -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="Curve"
                   Style="{StaticResource DialogOptionLabelStyle}"
                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
        Style="{StaticResource AxisPairPercentageSliderStyle}"
        Minimum="0"
        Maximum="4"
        TickFrequency="1"
        IsSnapToTickEnabled="True"
        Margin="8,0,10,0"
        Value="{Binding Primary.CurveStep,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

                                        <Border Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="5,2"
                CornerRadius="2"
                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Primary.CurvePercentageText}"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <TextBlock Grid.Row="5"
                                           Text="{Binding Primary.ConflictText}"
                                           Visibility="{Binding Primary.HasAxisConflict,
                                                                Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Style="{StaticResource DialogWarningTextBlockStyle}"
                                           Margin="0,10,0,0"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="100%"
                                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,3"/>

                                <Canvas x:Name="PrimaryResponsePlotCanvas"
        Grid.Row="1"
        Width="210"
        Height="210"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        SizeChanged="ResponsePlotCanvas_SizeChanged"/>

                                <Grid Grid.Row="2"
                                      Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="-100%"
                                               Foreground="{DynamicResource AppMutedForegroundBrush}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Input"
                                               Foreground="{DynamicResource AppMutedForegroundBrush}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="100%"
                                               Foreground="{DynamicResource AppMutedForegroundBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Secondary axis -->
                    <Border Grid.Row="1"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="18"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasSecondaryAxis,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Secondary.TitleText}"
                                           Style="{StaticResource DialogSectionLabelStyle}"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="18"
                                           Margin="0,0,0,10"/>

                                <Grid Grid.Row="1"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Assigned axis:"
                                               Style="{StaticResource DialogFieldLabelStyle}"
                                               Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Secondary.StatusText}"
                                               Style="{StaticResource DialogAssignmentValueStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Button Grid.Row="2"
                                        Content="{Binding Secondary.MapButtonText}"
                                        Width="146"
                                        HorizontalAlignment="Left"
                                        Command="{Binding MapSecondaryCommand}"
                                        Margin="0,0,0,12"/>

                                <CheckBox Grid.Row="3"
                                          Content="Invert"
                                          IsChecked="{Binding Secondary.Invert, Mode=TwoWay}"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,12"/>

                                <Grid Grid.Row="4"
      Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Roll deadzone. -->
                                    <Grid Grid.Row="0"
          Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="Deadzone"
                   Style="{StaticResource DialogOptionLabelStyle}"
                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
                Style="{StaticResource AxisPairPercentageSliderStyle}"
                Margin="8,0,10,0"
                Value="{Binding Secondary.DeadzoneStep,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                                        <Border Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="5,2"
                CornerRadius="2"
                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Secondary.DeadzonePercentageText}"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Roll saturation. -->
                                    <Grid Grid.Row="1"
          Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="Saturation"
                   Style="{StaticResource DialogOptionLabelStyle}"
                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
                Style="{StaticResource AxisPairPercentageSliderStyle}"
                Margin="8,0,10,0"
                Value="{Binding Secondary.SaturationStep,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                                        <Border Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="5,2"
                CornerRadius="2"
                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Secondary.SaturationPercentageText}"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Roll curve. -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="Curve"
                   Style="{StaticResource DialogOptionLabelStyle}"
                   VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1"
        Style="{StaticResource AxisPairPercentageSliderStyle}"
        Minimum="0"
        Maximum="4"
        TickFrequency="1"
        IsSnapToTickEnabled="True"
        Margin="8,0,10,0"
        Value="{Binding Secondary.CurveStep,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

                                        <Border Grid.Column="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="5,2"
                CornerRadius="2"
                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Secondary.CurvePercentageText}"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <TextBlock Grid.Row="5"
                                           Text="{Binding Secondary.ConflictText}"
                                           Visibility="{Binding Secondary.HasAxisConflict,
                                                                Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Style="{StaticResource DialogWarningTextBlockStyle}"
                                           Margin="0,10,0,0"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="100%"
                                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,3"/>

                                <Canvas x:Name="SecondaryResponsePlotCanvas"
        Grid.Row="1"
        Width="210"
        Height="210"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        SizeChanged="ResponsePlotCanvas_SizeChanged"/>

                                <Grid Grid.Row="2"
                                      Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="-100%"
                                               Foreground="{DynamicResource AppMutedForegroundBrush}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Input"
                                               Foreground="{DynamicResource AppMutedForegroundBrush}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="100%"
                                               Foreground="{DynamicResource AppMutedForegroundBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Clear"
                        Width="110"
                        Command="{Binding ClearCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="Cancel"
                        Width="96"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="Save"
                        Width="96"
                        IsDefault="True"
                        Style="{StaticResource TertiaryButtonStyle}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>