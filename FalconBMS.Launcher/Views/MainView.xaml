<UserControl x:Class="FalconBMS.Launcher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top">

            <!-- Falcon BMS Install and Theater side-by-side -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Falcon BMS Install"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Theater"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding Installs}"
                          SelectedItem="{Binding SelectedInstall, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="2"
                          ItemsSource="{Binding Theaters}"
                          SelectedItem="{Binding SelectedTheater, Mode=TwoWay}"
                          IsEditable="False"/>
            </Grid>

            <!-- Launch button on its own row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Launch"
                        Width="90"
                        Command="{Binding LaunchCommand}"/>
            </StackPanel>

            <!-- Shortcuts section for Docs and User folders -->
            <TextBlock Text="Shortcuts"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Docs Folder"
                        Width="80"
                        Margin="0,0,8,0"
                        Command="{Binding OpenDocsCommand}"/>

                <Button Content="User Folder"
                        Width="80"
                        Command="{Binding OpenUserCommand}"/>
            </StackPanel>

            <TextBlock Text="1st Party Apps"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <ItemsControl ItemsSource="{Binding FirstPartyItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding DataContext.LaunchFirstPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}"
                                Margin="0,0,10,8"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="DodgerBlue"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="3rd Party Apps"
                       FontWeight="SemiBold"
                       Margin="0,8,0,6"/>

            <ItemsControl ItemsSource="{Binding ThirdPartyItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding DataContext.LaunchThirdPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}"
                                Margin="0,0,10,8"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="DodgerBlue"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Launch Options"
                       FontWeight="SemiBold"
                       Margin="0,12,0,6"/>

            <WrapPanel Margin="0,0,0,8">
                <CheckBox Content="ACMI"
                          IsChecked="{Binding LaunchAcmi, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="WINDOW"
                          IsChecked="{Binding LaunchWindow, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="NOMOVIE"
                          IsChecked="{Binding LaunchNoMovie, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="EYEFLY"
                          IsChecked="{Binding LaunchEyeFly, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="DEBUG"
                          IsChecked="{Binding LaunchDebug, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="RTT Export"
                          IsChecked="{Binding ExportRttTextures, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
                <CheckBox Content="No VR"
                          IsChecked="{Binding VrNoVr, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="SteamVR"
                          IsChecked="{Binding VrSteamVr, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
                <CheckBox Content="OpenXR"
                          IsChecked="{Binding VrOpenXr, Mode=TwoWay}"
                          Margin="0,0,16,8"/>
            </WrapPanel>

            <TextBlock Text="{Binding StatusText}"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <Border Grid.Column="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="News"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="{Binding NewsStatusText}"
                                   Visibility="{Binding IsNewsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="Gray"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                            Padding="0,0,0,8">
                                        <StackPanel>

                                            <TextBlock Text="{Binding PublishedDisplay}"
                                                       Foreground="Gray"
                                                       FontSize="12"/>

                                            <TextBlock FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,2">
                                                <Hyperlink NavigateUri="{Binding Link}"
                                                           RequestNavigate="Hyperlink_RequestNavigate">
                                                    <Run Text="{Binding Title}"/>
                                                </Hyperlink>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Border>

    </Grid>
</UserControl>