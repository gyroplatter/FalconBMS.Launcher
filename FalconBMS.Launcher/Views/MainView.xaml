<UserControl x:Class="FalconBMS.Launcher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <ScrollViewer Background="{DynamicResource AppWindowBackgroundBrush}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
              Style="{StaticResource ViewContentRootStyle}"
              ClipToBounds="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="285"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="105"/>
            </Grid.RowDefinitions>

            <!-- Top row: choose the BMS version and theater, then launch -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BMS version selection -->
                <Border Grid.Column="0"
        Style="{StaticResource LaunchOptionDashboardCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardIconBadgeStyle}">
                                <ContentControl Style="{StaticResource DashboardBadgeVersionIconStyle}"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BMS Version"
                                    Style="{StaticResource DashboardLaunchOptionTitleStyle}"/>

                                <TextBlock Text="Choose which installed version of BMS to run."
                                    Style="{StaticResource DashboardLaunchOptionDescriptionStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <ComboBox Grid.Row="2"
                              Width="300"
                              ItemsSource="{Binding Installs}"
                              SelectedItem="{Binding SelectedInstall, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>

                        <Button Grid.Row="3"
        Style="{StaticResource AccentLinkButtonStyle}"
        Command="{Binding UpdateCommand}"
        Width="300"
        HorizontalAlignment="Center"
        HorizontalContentAlignment="Left"
        Margin="0,10,0,0"
        Padding="0">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource LinkUpdaterIconStyle}"
                        Width="18"
                        Height="18"
                        Margin="0,0,6,0"/>

                                <TextBlock Text="Check for Updates"
                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                   FontSize="{StaticResource FontSizeMedium}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Theater selection -->
                <Border Grid.Column="2"
        Style="{StaticResource LaunchOptionDashboardCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardIconBadgeStyle}">
                                <ContentControl Style="{StaticResource DashboardBadgeTheaterIconStyle}"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Theater"
                                       Style="{StaticResource DashboardLaunchOptionTitleStyle}"/>

                                <TextBlock Text="Choose which installed theater to start with."
                                       Style="{StaticResource DashboardLaunchOptionDescriptionStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <ComboBox Grid.Row="2"
                              Width="300"
                              ItemsSource="{Binding Theaters}"
                              SelectedItem="{Binding SelectedTheater, Mode=TwoWay}"
                              IsEditable="False"/>
                    </Grid>
                </Border>

                <!-- Launch BMS -->
                <Border Grid.Column="4"
                    Style="{StaticResource LaunchDashboardCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="58"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardIconBadgeStyle}">
                                <ContentControl Style="{StaticResource DashboardBadgeLaunchIconStyle}"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Launch"
                                       Style="{StaticResource DashboardLaunchOptionTitleStyle}"/>

                                <TextBlock Text="Run BMS with the selected version and theater."
                                       Style="{StaticResource DashboardLaunchOptionDescriptionStyle}" Width="316"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="2"
                            Width="300"
                            Style="{StaticResource LaunchDashboardButtonStyle}"
                            Content="Start Falcon BMS"
                            Command="{Binding LaunchCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Middle row: tools and quick access -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="108"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
            Style="{StaticResource DashboardIconBadgeStyle}">
                                <ContentControl Style="{StaticResource DashboardBadgeToolsIconStyle}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                VerticalAlignment="Center">
                                <TextBlock Text="Tools &amp; Utilities "
                   Style="{StaticResource DashboardTitleStyle}"/>

                                <TextBlock Text="Create and organize shortcuts to other apps."
                   Style="{StaticResource DashboardLaunchOptionDescriptionStyle}"
                   HorizontalAlignment="Left"
                   TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                            <StackPanel Orientation="Horizontal">

                                <ItemsControl x:Name="CommunityToolsItemsControl"
                                          ItemsSource="{Binding ThirdPartyItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="88"
                                                  Margin="0,0,8,0">

                                                <!--
                                                    The entire tile is now the mouse target:
                                                    icon, label, and surrounding blank space.
                                                -->
                                                <Button Tag="{Binding DisplayName}"
                                                        PreviewMouseLeftButtonDown="CommunityToolTile_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="CommunityToolTile_PreviewMouseMove"
                                                        PreviewMouseLeftButtonUp="CommunityToolTile_PreviewMouseLeftButtonUp">

                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource CommunityToolTileButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsEditingCommunityTools,
                                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="True">
                                                                    <Setter Property="Cursor"
                                                                            Value="SizeAll"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <Grid>

                                                        <!-- Generic fallback for an application with no icon -->
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl"
                                                                       BasedOn="{StaticResource LinkThirdPartyIconStyle}">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>

                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IconSource}"
                                                                                           Value="{x:Null}"/>

                                                                                <Condition Binding="{Binding IsBuiltInF4Wx}"
                                                                                           Value="False"/>
                                                                            </MultiDataTrigger.Conditions>

                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>

                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl"
                                                                       BasedOn="{StaticResource LinkF4WxIconStyle}">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBuiltInF4Wx}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>

                                                        <Image Source="{Binding IconSource}"
                                                               Width="38"
                                                               Height="38"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>

                                                <!--
                                                    Drag handle remains visible in edit mode, but is
                                                    visual-only. Mouse input passes through it to the
                                                    full tile underneath, so you can drag anywhere
                                                -->
                                                <Border Width="16"
                                                        Height="18"
                                                        Margin="9,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource AppSurfaceBrush}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsEditingCommunityTools,
                                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <UniformGrid Width="7"
                                                                 Height="10"
                                                                 Rows="3"
                                                                 Columns="2"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                    </UniformGrid>
                                                </Border>

                                                <!--
                                                    Delete remains its own independent button.

                                                    Margin moved inward so the close button sits
                                                    closer to the icon.
                                                -->
                                                <Button Width="18"
                                                        Height="18"
                                                        Margin="0,4,5,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="#C0392B"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveThirdPartyToolCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsEditingCommunityTools,
                                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="9">
                                                                <Path Width="8"
                                                                      Height="8"
                                                                      Stretch="Fill"
                                                                      Stroke="White"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      Data="M0,0 L8,8 M8,0 L0,8"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Normal mode -->
                                <Button Tag="Customize"
                                        Margin="0,0,8,0"
                                        Command="{Binding ToggleCommunityToolsEditCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource CommunityToolControlTileButtonStyle}">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingCommunityTools}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <ContentControl Style="{StaticResource LinkCustomizeIconStyle}"
                                                    Width="30"
                                                    Height="30"/>
                                </Button>

                                <!-- Modify/Add -->
                                <Button Tag="Add"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddThirdPartyToolCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource CommunityToolControlTileButtonStyle}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingCommunityTools}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Path Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M10,1 L10,19 M1,10 L19,10"/>
                                </Button>

                                <!-- Modify Done -->
                                <Button Tag="Done"
                                        Margin="0,0,8,0"
                                        Command="{Binding ToggleCommunityToolsEditCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource CommunityToolControlTileButtonStyle}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingCommunityTools}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Path Width="21"
                                          Height="17"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M1,9 L7,15 L20,1"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
            Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardIconBadgeStyle}">
                                <ContentControl Style="{StaticResource DashboardBadgeFolderIconStyle}"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quick Links"
                   Style="{StaticResource DashboardTitleStyle}"/>

                                <TextBlock Text="Open useful Falcon BMS resources."
                   Style="{StaticResource DashboardLaunchOptionDescriptionStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="76"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="76"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="70"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenDocsCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkManualIconStyle}"
                                                Margin="0,0,0,3"/>
                                    <TextBlock Text="Manuals &amp; Docs"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                </StackPanel>
                        </Button>

                        <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="70"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenUserCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkUserFolderIconStyle}"
                                                Margin="0,0,0,3"/>
                                    <TextBlock Text="User Folder"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                </StackPanel>
                        </Button>

                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="70"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenForumCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkForumIconStyle}"
                                                Margin="0,0,0,3"/>
                                    <TextBlock Text="BMS Forum"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                </StackPanel>
                        </Button>



                            <Button Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource DashboardTileButtonStyle}"
                                Height="70"
                                VerticalAlignment="Top"
                                Command="{Binding OpenScreenshotsCommand}">
                                <StackPanel>
                                    <ContentControl Style="{StaticResource LinkScreenshotsIconStyle}"
                                                Margin="0,0,0,3"/>
                                    <TextBlock Text="Screenshots"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom row: compact text-only RSS feed. Extra feed items are intentionally clipped here. -->
        <Border Grid.Row="4" Style="{StaticResource DashboardCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource DashboardIconBadgeStyle}">
                        <ContentControl Style="{StaticResource DashboardBadgeNewsIconStyle}"/>
                    </Border>
                    <TextBlock Text="News" Style="{StaticResource DashboardTitleStyle}"/>
                </StackPanel>

                <Grid Grid.Column="2" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="{Binding NewsStatusText}"
                                   Visibility="{Binding IsNewsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding NewsItems}"
                                      AlternationCount="3"
                                      ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Three equal-width columns for the three latest RSS items -->
                                    <UniformGrid Columns="3" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Keep all three columns visually equal -->
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Padding" Value="18,0,18,0"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>

                                                <!-- First item should align closer to the News heading -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="0">
                                                        <Setter Property="Padding" Value="0,0,18,0"/>
                                                    </DataTrigger>

                                                    <!-- Items 2 and 3 get only a left divider-->
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="1">
                                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="2">
                                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding PublishedDisplay}"
                                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Margin="0,0,0,2"/>

                                            <TextBlock Style="{StaticResource DashboardSectionLabelStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,2">
                                            <Hyperlink NavigateUri="{Binding Link}"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Style="{StaticResource NewsHeadlineHyperlinkStyle}">
                                                    <Run Text="{Binding Title}"/>
                                                </Hyperlink>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="30"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>