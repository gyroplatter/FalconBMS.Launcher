<UserControl x:Class="FalconBMS.Launcher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="536">

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top">

            <!-- Falcon BMS Install and Theater side-by-side -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Falcon BMS Install"
                           Style="{StaticResource SubheadingTextBlockStyle}"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Theater"
                           Style="{StaticResource SubheadingTextBlockStyle}"
                           Margin="0,0,0,4"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding Installs}"
                          SelectedItem="{Binding SelectedInstall, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="2"
                          ItemsSource="{Binding Theaters}"
                          SelectedItem="{Binding SelectedTheater, Mode=TwoWay}"
                          IsEditable="False"/>
            </Grid>

            <!-- Launch BMS -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource PrimaryButtonStyle}"
            Content="Launch"
            Width="90"
            Command="{Binding LaunchCommand}"/>
            </StackPanel>

            <!-- Shortcuts for Docs and User folders -->
            <TextBlock Text="Shortcuts"
           Style="{StaticResource SubheadingTextBlockStyle}"
                       Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource SecondaryButtonStyle}"
            Content="Docs Folder"
            Width="80"
            Margin="0,0,8,0"
            Command="{Binding OpenDocsCommand}"/>

                <Button Style="{StaticResource SecondaryButtonStyle}"
            Content="User Folder"
            Width="80"
            Command="{Binding OpenUserCommand}"/>
            </StackPanel>

            <TextBlock Text="1st Party Apps"
           Style="{StaticResource SubheadingTextBlockStyle}"
                       Margin="0,0,0,6"/>

            <ItemsControl ItemsSource="{Binding FirstPartyItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding DataContext.LaunchFirstPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}"
                                Margin="0,0,10,8"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource AppAccentBrush}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="3rd Party Apps"
           Style="{StaticResource SubheadingTextBlockStyle}"
                       Margin="0,8,0,6"/>

            <ItemsControl ItemsSource="{Binding ThirdPartyItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding DataContext.LaunchThirdPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}"
                                Margin="0,0,10,8"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource AppAccentBrush}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="BMS Launch Options"
           Style="{StaticResource SubheadingTextBlockStyle}"
                       Margin="0,12,0,6"/>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Config:"
               Style="{StaticResource BodyTextBlockStyle}"
               Margin="0,0,12,8"/>

                <CheckBox Content="ACMI"
              IsChecked="{Binding LaunchAcmi, Mode=TwoWay}"
              Margin="0,0,16,8"/>
                <CheckBox Content="WINDOW"
              IsChecked="{Binding LaunchWindow, Mode=TwoWay}"
              Margin="0,0,16,8"/>
                <CheckBox Content="NOMOVIE"
              IsChecked="{Binding LaunchNoMovie, Mode=TwoWay}"
              Margin="0,0,16,8"/>
                <CheckBox Content="EYEFLY"
              IsChecked="{Binding LaunchEyeFly, Mode=TwoWay}"
              Margin="0,0,16,8"/>
                <CheckBox Content="DEBUG"
              IsChecked="{Binding LaunchDebug, Mode=TwoWay}"
              Margin="0,0,16,8"/>
                <CheckBox Content="RTT Export"
              IsChecked="{Binding ExportRttTextures, Mode=TwoWay}"
              Margin="0,0,16,8"/>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="VR:"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Margin="0,0,12,8"/>

                <RadioButton Content="No VR"
                             GroupName="VrMode"
                             IsChecked="{Binding VrNoVr, Mode=TwoWay}"
                             Margin="0,0,16,8"/>

                <RadioButton Content="SteamVR"
                             GroupName="VrMode"
                             IsChecked="{Binding VrSteamVr, Mode=TwoWay}"
                             Margin="0,0,16,8"/>

                <RadioButton Content="OpenXR"
                             GroupName="VrMode"
                             IsChecked="{Binding VrOpenXr, Mode=TwoWay}"
                             Margin="0,0,16,8"/>
            </WrapPanel>

            <TextBlock Text="Alternative Launcher Options"
           Style="{StaticResource SubheadingTextBlockStyle}"
                       Margin="0,4,0,6"/>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Theme:"
               Style="{StaticResource BodyTextBlockStyle}"
               Margin="0,0,12,8"/>

                <RadioButton Content="Auto"
                 GroupName="LauncherThemeMode"
                 IsChecked="{Binding LauncherThemeAuto, Mode=TwoWay}"
                 Margin="0,0,16,8"/>
                <RadioButton Content="Light"
                 GroupName="LauncherThemeMode"
                 IsChecked="{Binding LauncherThemeLight, Mode=TwoWay}"
                 Margin="0,0,16,8"/>
                <RadioButton Content="Dark"
                 GroupName="LauncherThemeMode"
                 IsChecked="{Binding LauncherThemeDark, Mode=TwoWay}"
                 Margin="0,0,16,8"/>
            </WrapPanel>

            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <Border Grid.Column="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppSurfaceBrush}"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="News"
                           Style="{StaticResource SubheadingTextBlockStyle}"
                           Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="{Binding NewsStatusText}"
                                   Visibility="{Binding IsNewsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            Padding="0,0,0,8">
                                        <StackPanel>

                                            <TextBlock Text="{Binding PublishedDisplay}"
                                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                                       FontSize="12"/>

                                            <TextBlock FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,2">
                                                <Hyperlink NavigateUri="{Binding Link}"
                                                           RequestNavigate="Hyperlink_RequestNavigate">
                                                    <Run Text="{Binding Title}"/>
                                                </Hyperlink>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Border>

    </Grid>
</UserControl>