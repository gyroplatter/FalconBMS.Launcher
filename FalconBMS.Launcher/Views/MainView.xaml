<UserControl x:Class="FalconBMS.Launcher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <UserControl.Resources>
        <Style x:Key="DashboardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubheadingTextBlockStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DashboardSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="DashboardFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="DashboardIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="DashboardIconBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DashboardTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
      Style="{StaticResource ViewContentRootStyle}"
      ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="285"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="105"/>
        </Grid.RowDefinitions>

        <!-- Top row: launch controls and Falcon BMS launch settings. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeLaunchIconStyle}"/>
                        </Border>
                        <TextBlock Text="Launch Falcon BMS" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Install"
                                   Style="{StaticResource DashboardSectionLabelStyle}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="0"
                                  Height="34"
                                  ItemsSource="{Binding Installs}"
                                  SelectedItem="{Binding SelectedInstall, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Theater"
                                   Style="{StaticResource DashboardSectionLabelStyle}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="2"
                                  Height="34"
                                  ItemsSource="{Binding Theaters}"
                                  SelectedItem="{Binding SelectedTheater, Mode=TwoWay}"
                                  IsEditable="False"/>
                    </Grid>

                    <Button Grid.Row="4"
                            Style="{StaticResource LaunchDashboardButtonStyle}"
                            Content="Launch Falcon BMS"
                            Command="{Binding LaunchCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeGearIconStyle}"/>
                        </Border>
                        <TextBlock Text="Settings" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Display &amp; Output" Style="{StaticResource DashboardSectionLabelStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0"
                                          Grid.Column="0"
                                          Content="Windowed Mode"
                                          IsChecked="{Binding LaunchWindow, Mode=TwoWay}"
                                          Margin="0,0,18,10"/>

                                <CheckBox Grid.Row="0"
                                          Grid.Column="1"
                                          Content="ACMI Recording"
                                          IsChecked="{Binding LaunchAcmi, Mode=TwoWay}"
                                          Margin="0,0,0,10"/>

                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          Content="RTT Export"
                                          IsChecked="{Binding ExportRttTextures, Mode=TwoWay}"
                                          Margin="0,0,18,0"/>

                                <CheckBox Grid.Row="1"
                                          Grid.Column="1"
                                          Content="EyeFly"
                                          IsChecked="{Binding LaunchEyeFly, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1,0,0,0"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Startup" Style="{StaticResource DashboardSectionLabelStyle}"/>

                            <CheckBox Content="Skip Intro Videos"
                                      IsChecked="{Binding LaunchNoMovie, Mode=TwoWay}"
                                      Margin="0,0,0,10"/>

                            <CheckBox Content="Debug Mode"
                                      IsChecked="{Binding LaunchDebug, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"/>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VR Mode"
                                       Style="{StaticResource DashboardSectionLabelStyle}"/>

                            <!-- Keep VR choices close together so this row can also hold launcher theme settings. -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="No VR"
                                             GroupName="VrMode"
                                             IsChecked="{Binding VrNoVr, Mode=TwoWay}"
                                             Margin="0,0,28,0"/>

                                <RadioButton Content="SteamVR"
                                             GroupName="VrMode"
                                             IsChecked="{Binding VrSteamVr, Mode=TwoWay}"
                                             Margin="0,0,28,0"/>

                                <RadioButton Content="OpenXR"
                                             GroupName="VrMode"
                                             IsChecked="{Binding VrOpenXr, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1,0,0,0"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Launcher Theme"
                                       Style="{StaticResource DashboardSectionLabelStyle}"/>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Auto"
                                             GroupName="LauncherThemeMode"
                                             IsChecked="{Binding LauncherThemeAuto, Mode=TwoWay}"
                                             Margin="0,0,24,0"/>

                                <RadioButton Content="Light"
                                             GroupName="LauncherThemeMode"
                                             IsChecked="{Binding LauncherThemeLight, Mode=TwoWay}"
                                             Margin="0,0,24,0"/>

                                <RadioButton Content="Dark"
                                             GroupName="LauncherThemeMode"
                                             IsChecked="{Binding LauncherThemeDark, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Middle row: tools and quick access. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeToolsIconStyle}"/>
                        </Border>
                        <TextBlock Text="Tools" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="Falcon BMS Tools"
                               Style="{StaticResource DashboardSectionLabelStyle}"/>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding FirstPartyItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DashboardTileButtonStyle}"
                                        Width="86"
                                        Height="62"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.LaunchFirstPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkPlaceholderIconStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="updater">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="config">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="display-config">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-client">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-server">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-client">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-server">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="avionics-configurator">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="editor">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkUpdaterIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="updater">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkConfigIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="config">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkDisplayIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="display-config">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkRttClientIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-client">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkRttServerIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-server">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkIvcClientIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-client">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkIvcServerIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-server">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkAvionicsIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="avionics-configurator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkEditorIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="editor">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource AppForegroundBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeMedium}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   LineHeight="13"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="6"
                               Text="Community Tools"
                               Style="{StaticResource DashboardSectionLabelStyle}"/>

                    <ItemsControl Grid.Row="8" ItemsSource="{Binding ThirdPartyItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DashboardTileButtonStyle}"
                                        Width="158"
                                        Height="52"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.LaunchThirdPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkThirdPartyIconStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="wdp">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="mission-commander">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="weather-commander">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="f4wx">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="f4radar">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkWdpIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="wdp">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkMissionCommanderIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="mission-commander">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkWeatherCommanderIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="weather-commander">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkF4WxIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="f4wx">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkF4RadarIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="f4radar">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Foreground="{DynamicResource AppForegroundBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeMedium}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   LineHeight="14"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeFolderIconStyle}"/>
                        </Border>
                        <TextBlock Text="Quick Access" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="Shortcuts"
                               Style="{StaticResource DashboardSectionLabelStyle}"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="68"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="62"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenDocsCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkManualIconStyle}"
                                                Margin="0,0,0,3"/>
                                <TextBlock Text="Manuals &amp; Docs"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="62"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenUserCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkPlaceholderIconStyle}"
                                                Margin="0,0,0,3"/>
                                <TextBlock Text="User Folder"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="62"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenForumCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkForumIconStyle}"
                                                Margin="0,0,0,3"/>
                                <TextBlock Text="BMS Forum"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom row: compact text-only RSS feed. Extra feed items are intentionally clipped here. -->
        <Border Grid.Row="4" Style="{StaticResource DashboardCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource DashboardIconBadgeStyle}">
                        <ContentControl Style="{StaticResource DashboardBadgeNewsIconStyle}"/>
                    </Border>
                    <TextBlock Text="News" Style="{StaticResource DashboardTitleStyle}"/>
                </StackPanel>

                <Grid Grid.Column="2" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="{Binding NewsStatusText}"
                                   Visibility="{Binding IsNewsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding NewsItems}"
                                      AlternationCount="3"
                                      ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Three equal-width columns for the three latest RSS items. -->
                                    <UniformGrid Columns="3" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Keep all three columns visually equal. -->
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Padding" Value="18,0,18,0"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>

                                                <!-- First item should align closer to the News heading. -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="0">
                                                        <Setter Property="Padding" Value="0,0,18,0"/>
                                                    </DataTrigger>

                                                    <!-- Items 2 and 3 get only a left divider. No right divider is ever drawn. -->
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="1">
                                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="2">
                                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding PublishedDisplay}"
                                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Margin="0,0,0,2"/>

                                            <TextBlock Style="{StaticResource DashboardSectionLabelStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextDecorations="Underline"
                                                       Margin="0,0,0,2">
                                                <Hyperlink NavigateUri="{Binding Link}"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           TextDecorations="Underline">
                                                    <Run Text="{Binding Title}"/>
                                                </Hyperlink>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="30"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>