<UserControl x:Class="FalconBMS.Launcher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <UserControl.Resources>
        <Style x:Key="DashboardSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="DashboardFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="DashboardIconBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DashboardTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommunityToolCircleStyle"
       TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Background"
            Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush"
            Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness"
            Value="1"/>
            <Setter Property="Cursor"
            Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                 Value="True">
                    <Setter Property="BorderBrush"
                    Value="{DynamicResource AppAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommunityToolControlButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background"
                    Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="25"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource AppWindowBackgroundBrush}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
              Style="{StaticResource ViewContentRootStyle}"
              ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="230"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="305"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="105"/>
        </Grid.RowDefinitions>

        <!-- Top row: launch controls and Falcon BMS launch settings. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LaunchDashboardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeLaunchIconStyle}"/>
                        </Border>
                        <TextBlock Text="Launch Falcon BMS" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Install"
                                   Style="{StaticResource DashboardSectionLabelStyle}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="0"
                                  Height="34"
                                  ItemsSource="{Binding Installs}"
                                  SelectedItem="{Binding SelectedInstall, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Theater"
                                   Style="{StaticResource DashboardSectionLabelStyle}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="2"
                                  Height="34"
                                  ItemsSource="{Binding Theaters}"
                                  SelectedItem="{Binding SelectedTheater, Mode=TwoWay}"
                                  IsEditable="False"/>
                    </Grid>

                    <Button Grid.Row="4"
                            Style="{StaticResource LaunchDashboardButtonStyle}"
                            Content="Launch Falcon BMS"
                            Command="{Binding LaunchCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Middle row: tools and quick access. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="76"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="86"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeToolsIconStyle}"/>
                        </Border>
                        <TextBlock Text="Tools" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="Falcon BMS Tools"
                               Style="{StaticResource DashboardSectionLabelStyle}"/>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding FirstPartyItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DashboardTileButtonStyle}"
                                        Width="86"
                                        Height="62"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.LaunchFirstPartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkPlaceholderIconStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="updater">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="config">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="display-config">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-client">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-server">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-client">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-server">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="avionics-configurator">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="editor">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkUpdaterIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="updater">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkConfigIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="config">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkDisplayIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="display-config">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkRttClientIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-client">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkRttServerIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="rtt-server">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkIvcClientIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-client">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkIvcServerIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="ivc-server">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkAvionicsIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="avionics-configurator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <ContentControl>
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource LinkEditorIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="editor">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>
                                            <TextBlock Text="{Binding Label}"
                                                Style="{StaticResource DashboardToolNameTextStyle}"/>
                                        </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="6"
                               Text="Community Tools"
                               Style="{StaticResource DashboardSectionLabelStyle}"/>

                        <ScrollViewer Grid.Row="8"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                            <StackPanel Orientation="Horizontal">

                                <ItemsControl x:Name="CommunityToolsItemsControl"
                                          ItemsSource="{Binding ThirdPartyItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="70"
                                              Margin="0,0,8,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="52"/>
                                                    <RowDefinition Height="24"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        HorizontalAlignment="Center"
                                                        PreviewMouseLeftButtonDown="CommunityToolTile_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="CommunityToolTile_PreviewMouseMove"
                                                        PreviewMouseLeftButtonUp="CommunityToolTile_PreviewMouseLeftButtonUp">

                                                    <Border.Style>
                                                        <Style TargetType="Border"
                                                               BasedOn="{StaticResource CommunityToolCircleStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsEditingCommunityTools,
                                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="True">
                                                                    <!-- Four-direction arrow cursor indicating that the tile can be moved. -->
                                                                    <Setter Property="Cursor"
                                                                            Value="SizeAll"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>

                                                        <!-- Generic fallback for a user-added
                                                         application whose icon extraction failed. -->
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl"
                                                                   BasedOn="{StaticResource LinkThirdPartyIconStyle}">
                                                                    <Setter Property="Visibility"
                                                                        Value="Collapsed"/>

                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IconSource}"
                                                                                       Value="{x:Null}"/>

                                                                                <Condition Binding="{Binding IsBuiltInF4Wx}"
                                                                                       Value="False"/>
                                                                            </MultiDataTrigger.Conditions>

                                                                            <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>

                                                        <!-- Preserve the launcher's existing
                                                         built-in F4Wx icon. -->
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl"
                                                                   BasedOn="{StaticResource LinkF4WxIconStyle}">
                                                                    <Setter Property="Visibility"
                                                                        Value="Collapsed"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBuiltInF4Wx}"
                                                                                 Value="True">
                                                                            <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>

                                                        <Image Source="{Binding IconSource}"
                                                           Width="34"
                                                           Height="34"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Six-dot drag handle shown only while customizing. -->
                                                <Border Grid.Row="0"
                                                    Width="16"
                                                    Height="18"
                                                    Margin="-1,4,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource AppSurfaceBrush}"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Cursor="SizeAll"
                                                    PreviewMouseLeftButtonDown="CommunityToolTile_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="CommunityToolTile_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="CommunityToolTile_PreviewMouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsEditingCommunityTools,
                                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <UniformGrid Width="7"
                                                                 Height="10"
                                                                 Rows="3"
                                                                 Columns="2"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                        <Ellipse Width="2"
                                                                 Height="2"
                                                                 Fill="{DynamicResource AppMutedForegroundBrush}"/>
                                                    </UniformGrid>
                                                </Border>

                                                <Button Grid.Row="0"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,4,-1,0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="#C0392B"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveThirdPartyToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility"
                    Value="Collapsed"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsEditingCommunityTools, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                                                                    <Setter Property="Visibility"
                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                    CornerRadius="9">
                                                                <Path Width="8"
                      Height="8"
                      Stretch="Fill"
                      Stroke="White"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M0,0 L8,8 M8,0 L0,8"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayName}"
                                                   Style="{StaticResource DashboardToolNameTextStyle}"
                                                   ToolTip="{Binding DisplayName}"
                                                   Margin="1,3,1,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Normal mode. -->
                                <Grid Width="76"
                                  Margin="0,0,8,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility"
                                                Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingCommunityTools}"
                                                         Value="True">
                                                    <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0"
                                        Style="{StaticResource CommunityToolControlButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ToggleCommunityToolsEditCommand}">
                                            <ContentControl Style="{StaticResource LinkCustomizeIconStyle}" 
                                               Width="30"
                                               Height="30"/>
                                    </Button>

                                    <TextBlock Grid.Row="1"
                                       Text="Customize"
                                       Style="{StaticResource DashboardToolNameTextStyle}"
                                       Margin="0,3,0,0"/>
                                </Grid>

                                <!-- Modify-mode Add. -->
                                <Grid Width="70"
                                  Margin="0,0,8,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingCommunityTools}"
                                                         Value="True">
                                                    <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0"
                                        Style="{StaticResource CommunityToolControlButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding AddThirdPartyToolCommand}">
                                        <Path Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M10,1 L10,19 M1,10 L19,10"/>
                                    </Button>

                                    <TextBlock Grid.Row="1"
                                           Text="Add"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Margin="0,3,0,0"/>
                                </Grid>

                                <!-- Modify-mode Done. -->
                                <Grid Width="70"
                                  Margin="0,0,8,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingCommunityTools}"
                                                         Value="True">
                                                    <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0"
                                        Style="{StaticResource CommunityToolControlButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ToggleCommunityToolsEditCommand}">
                                        <Path Width="21"
                                          Height="17"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M1,9 L7,15 L20,1"/>
                                    </Button>

                                    <TextBlock Grid.Row="1"
                                           Text="Done"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Margin="0,3,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource DashboardIconBadgeStyle}">
                            <ContentControl Style="{StaticResource DashboardBadgeFolderIconStyle}"/>
                        </Border>
                        <TextBlock Text="Quick Access" Style="{StaticResource DashboardTitleStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="Shortcuts"
                               Style="{StaticResource DashboardSectionLabelStyle}"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="68"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="62"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenDocsCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkManualIconStyle}"
                                                Margin="0,0,0,3"/>
                                <TextBlock Text="Manuals &amp; Docs"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="62"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenUserCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkUserFolderIconStyle}"
                                                Margin="0,0,0,3"/>
                                <TextBlock Text="User Folder"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource DashboardTileButtonStyle}"
                                    Height="62"
                                    VerticalAlignment="Top"
                                    Command="{Binding OpenForumCommand}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource LinkForumIconStyle}"
                                                Margin="0,0,0,3"/>
                                <TextBlock Text="BMS Forum"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Button>



                            <Button Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource DashboardTileButtonStyle}"
                                Height="62"
                                VerticalAlignment="Top"
                                Command="{Binding OpenScreenshotsCommand}">
                                <StackPanel>
                                    <ContentControl Style="{StaticResource LinkScreenshotsIconStyle}"
                                                Margin="0,0,0,3"/>
                                    <TextBlock Text="Screenshots"
                                           Foreground="{DynamicResource AppForegroundBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom row: compact text-only RSS feed. Extra feed items are intentionally clipped here. -->
        <Border Grid.Row="4" Style="{StaticResource DashboardCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource DashboardIconBadgeStyle}">
                        <ContentControl Style="{StaticResource DashboardBadgeNewsIconStyle}"/>
                    </Border>
                    <TextBlock Text="News" Style="{StaticResource DashboardTitleStyle}"/>
                </StackPanel>

                <Grid Grid.Column="2" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="{Binding NewsStatusText}"
                                   Visibility="{Binding IsNewsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                                   Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding NewsItems}"
                                      AlternationCount="3"
                                      ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Three equal-width columns for the three latest RSS items. -->
                                    <UniformGrid Columns="3" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Keep all three columns visually equal. -->
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Padding" Value="18,0,18,0"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>

                                                <!-- First item should align closer to the News heading. -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="0">
                                                        <Setter Property="Padding" Value="0,0,18,0"/>
                                                    </DataTrigger>

                                                    <!-- Items 2 and 3 get only a left divider. No right divider is ever drawn. -->
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="1">
                                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                 Value="2">
                                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding PublishedDisplay}"
                                                       Foreground="{DynamicResource AppMutedForegroundBrush}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Margin="0,0,0,2"/>

                                            <TextBlock Style="{StaticResource DashboardSectionLabelStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextDecorations="Underline"
                                                       Margin="0,0,0,2">
                                                <Hyperlink NavigateUri="{Binding Link}"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           TextDecorations="Underline">
                                                    <Run Text="{Binding Title}"/>
                                                </Hyperlink>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="30"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>