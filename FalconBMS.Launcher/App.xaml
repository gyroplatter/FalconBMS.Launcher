<Application x:Class="FalconBMS.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FalconBMS.Launcher"
             xmlns:converters="clr-namespace:FalconBMS.Launcher.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared styles first, then a default theme dictionary that ThemeService can replace at startup. -->
                <ResourceDictionary Source="Styles/Theme.Shared.xaml"/>
                <ResourceDictionary Source="Styles/Theme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:EnumEqualsConverter x:Key="EnumEquals"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>