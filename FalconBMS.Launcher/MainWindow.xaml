<Window x:Class="FalconBMS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FalconBMS.Launcher.Views"
        xmlns:vm="clr-namespace:FalconBMS.Launcher.ViewModels"
        Title="Falcon BMS Launcher"
        Width="1280"
        Height="850"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ViewsViewModel}">
            <views:ViewsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ControlsViewModel}">
            <views:ControlsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StylesViewModel}">
            <views:StylesView/>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: header with logo and nav -->
            <RowDefinition Height="*"/>
            <!-- Row 1: content -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: header logo and nav row -->
        <Border Grid.Row="0"
        Style="{StaticResource MainWindowHeaderBorderStyle}"
        Padding="0"
        ClipToBounds="True">
            <Grid>
                <!-- Full-opacity source image. The Launcher fades it with overlays below. -->
                <Image Source="Assets/background-header.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Main fade/tint layer. Increase opacity to make the image more subtle. -->
                <Border Background="{DynamicResource AppHeaderBackgroundBrush}"
                Opacity="0.50"/>

                <!-- Extra readability gradient: darker behind the logo and nav text -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#A0000000" Offset="0.00"/>
                            <GradientStop Color="#55000000" Offset="0.35"/>
                            <GradientStop Color="#55000000" Offset="0.65"/>
                            <GradientStop Color="#A0000000" Offset="1.00"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Existing header content -->
                <Grid Margin="18,0,56,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                   Source="Assets/bms-logo.png"
                   Style="{StaticResource MainWindowHeaderLogoStyle}"/>

                    <views:LauncherNavBar Grid.Column="2"
                                  Style="{StaticResource MainWindowHeaderNavHostStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 1: active tab content -->
        <ContentControl Grid.Row="1"
                Content="{Binding CurrentViewModel}"
                Style="{StaticResource MainContentControlStyle}"/>

        <!-- Row 2: footer -->
        <Border Grid.Row="2"
                Padding="10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppSurfaceBrush}">
            <TextBlock Text="{Binding Main.LauncherVersion}" />
        </Border>
    </Grid>
</Window>