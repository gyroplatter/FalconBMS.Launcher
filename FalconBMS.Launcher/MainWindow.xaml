<Window x:Class="FalconBMS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FalconBMS.Launcher.Views"
        xmlns:vm="clr-namespace:FalconBMS.Launcher.ViewModels"
        Title="Falcon BMS Launcher"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ViewsViewModel}">
            <views:ViewsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StylesViewModel}">
            <views:StylesView/>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: nav -->
            <RowDefinition Height="*"/>
            <!-- Row 2: content -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: footer -->
        </Grid.RowDefinitions>

        <!-- Row 1: header logo row -->
        <Border Grid.Row="0" Padding="12" Background="{DynamicResource AppHeaderBackgroundBrush}">
            <Image Source="Assets/bms-logo.png"
                   Height="40"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"/>
        </Border>

        <!-- Row 2: nav -->
        <views:LauncherNavBar Grid.Row="1"/>

        <!-- Row 3: active tab content -->
        <ContentControl Grid.Row="2"
                Content="{Binding CurrentViewModel}"
                Style="{StaticResource MainContentControlStyle}"/>

        <!-- Row 4: footer -->
        <Border Grid.Row="3"
                Padding="10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppSurfaceBrush}">
            <TextBlock Text="{Binding Main.LauncherVersion}" />
        </Border>
    </Grid>
</Window>