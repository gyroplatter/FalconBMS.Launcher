<Window x:Class="FalconBMS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FalconBMS.Launcher.Views"
        xmlns:vm="clr-namespace:FalconBMS.Launcher.ViewModels"
        Title="Falcon BMS Launcher"
        Width="1280"
        Height="850"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
            <views:DisplayView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ViewsViewModel}">
            <views:ViewsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ControlsViewModel}">
            <views:ControlsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StylesViewModel}">
            <views:StylesView/>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: header with logo and nav -->
            <RowDefinition Height="2"/>
            <!-- Row 1: header/body accent separator -->
            <RowDefinition Height="*"/>
            <!-- Row 2: content -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: header logo and nav row -->
        <Border Grid.Row="0"
                Style="{StaticResource MainWindowHeaderBorderStyle}"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <!-- Theme-specific header artwork -->
                <Image Source="{DynamicResource AppHeaderBackgroundImage}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Header content -->
                <Grid Margin="18,0,56,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <Image Grid.Column="0"
                           Source="{DynamicResource AppHeaderLogoImage}"
                           Style="{StaticResource MainWindowHeaderLogoStyle}"/>

                    <views:LauncherNavBar Grid.Column="2"
                                          Style="{StaticResource MainWindowHeaderNavHostStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 1: header/body accent separator -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppHeaderSeparatorBrush}"/>

        <!-- Row 2: active tab content -->
        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentViewModel}"
                        Style="{StaticResource MainContentControlStyle}"/>

        <!-- Row 3: footer -->
        <Border Grid.Row="3"
            Padding="10"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource AppSurfaceBrush}">
                <TextBlock Text="{Binding Main.LauncherVersion}"
                   Foreground="{DynamicResource AppMutedForegroundBrush}"
                   FontSize="{StaticResource FontSizeSmall}"/>
        </Border>

        <!-- Modal overlay shown behind popup windows. -->
        <Border x:Name="ModalOverlay"
                Grid.RowSpan="4"
                Background="{DynamicResource AppModalOverlayBrush}"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                Panel.ZIndex="1000"/>
    </Grid>
</Window>