<Window x:Class="FalconBMS.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FalconBMS.Launcher.Views"
        xmlns:vm="clr-namespace:FalconBMS.Launcher.ViewModels"
        Title="Falcon BMS Launcher"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ControlsViewModel}">
            <views:ControlsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AudioViewModel}">
            <views:AudioView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ViewsViewModel}">
            <views:ViewsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KeymappingViewModel}">
            <views:KeymappingView/>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 1: header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: nav -->
            <RowDefinition Height="*"/>
            <!-- Row 3: content -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: footer -->
        </Grid.RowDefinitions>

        <!-- Row 1: header logo row -->
        <Border Grid.Row="0" Padding="12" Background="#1E232E">
            <Image Source="Assets/bms-logo.png"
           Height="40"
           Stretch="Uniform"
           HorizontalAlignment="Left"/>
        </Border>

        <!-- Row 2: nav -->
        <views:LauncherNavBar Grid.Row="1"/>

        <!-- Row 3: active tab content -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" />

        <!-- Row 4: footer -->
        <Border Grid.Row="3" Padding="10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <TextBlock Text="{Binding Main.LauncherVersion}" />
        </Border>
    </Grid>
</Window>