<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark mode -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#11161D"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1E232E"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#2C303B"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#959CB1"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#7CA9E6"/>
    <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#0D1218"/>
    <SolidColorBrush x:Key="AppModalOverlayBrush" Color="#B0000000"/>

    <!-- Header/body separator line -->
    <SolidColorBrush x:Key="AppHeaderSeparatorBrush" Color="#4EA1FF"/>

    <!-- Launch panel background -->
    <SolidColorBrush x:Key="LaunchDashboardCardBrush" Color="#172535"/>
    <SolidColorBrush x:Key="LaunchDashboardCardBorderBrush" Color="#35597C"/>

    <!-- Used by DialogCardStyle -->
    <SolidColorBrush x:Key="AppDialogCardBorderBrush" Color="#4D5870"/>
    <SolidColorBrush x:Key="AppDialogCardSurfaceBrush" Color="#F21E232E"/>

    <LinearGradientBrush x:Key="AppDialogCardAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#7CA9E6"/>
        <GradientStop Offset="1" Color="#4D5870"/>
    </LinearGradientBrush>

    <!-- Warning text color used for overwrite/conflict warnings -->
    <SolidColorBrush x:Key="AppWarningTextBrush" Color="#FF8A80"/>

    <!-- Controls table -->
    <SolidColorBrush x:Key="ControlsTableHeaderBrush" Color="#262D3A"/>
    <SolidColorBrush x:Key="ControlsTableGridLineBrush" Color="#334455"/>

    <!-- Editable-row hover -->
    <SolidColorBrush x:Key="ControlsTableHoverBrush" Color="#2B3038"/>

    <!-- Active/selected row -->
    <SolidColorBrush x:Key="ControlsTableSelectedBrush" Color="#4A3820"/>

    <!-- Section heading -->
    <SolidColorBrush x:Key="ControlsTableSectionBackgroundBrush" Color="#173A55"/>
    <SolidColorBrush x:Key="ControlsTableSectionForegroundBrush" Color="#F3F8FF"/>

    <!-- Subheading -->
    <SolidColorBrush x:Key="ControlsTableSubsectionBackgroundBrush" Color="#263442"/>
    <SolidColorBrush x:Key="ControlsTableSubsectionForegroundBrush" Color="#DDEBFA"/>

    <SolidColorBrush x:Key="ControlsTableAxisBackgroundBrush" Color="#1B2B38"/>
    <SolidColorBrush x:Key="ControlsTableCommentBackgroundBrush" Color="#1A2029"/>
    <SolidColorBrush x:Key="ControlsTableCommentForegroundBrush" Color="#A5ADBA"/>
    <SolidColorBrush x:Key="ControlsTableOfflineDeviceBackgroundBrush" Color="#252A33"/>

    <SolidColorBrush x:Key="AppHeadingForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSubHeadingForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBodyForegroundBrush" Color="#D1D5DB"/>

    <SolidColorBrush x:Key="ControlsTableAxisBadgeBackgroundBrush" Color="#244760"/>
    <SolidColorBrush x:Key="ControlsTableAxisBadgeForegroundBrush" Color="#EAF5FF"/>
    <SolidColorBrush x:Key="ControlsTableAxisBadgeBorderBrush" Color="#3D6684"/>

    <!-- Checkbox -->
    <SolidColorBrush x:Key="AppCheckBoxBackgroundBrush" Color="#1E232E"/>
    <SolidColorBrush x:Key="AppCheckBoxBorderBrush" Color="#64788F"/>
    <SolidColorBrush x:Key="AppCheckBoxHoverBorderBrush" Color="#2F8DF2"/>
    <SolidColorBrush x:Key="AppCheckBoxCheckedBrush" Color="#2F8DF2"/>
    <SolidColorBrush x:Key="AppCheckBoxCheckBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppCheckBoxDisabledBackgroundBrush" Color="#3A414D"/>
    <SolidColorBrush x:Key="AppCheckBoxDisabledBorderBrush" Color="#4A5564"/>
    <SolidColorBrush x:Key="AppCheckBoxDisabledCheckBrush" Color="#A0A8B4"/>
    
    <!-- Default button -->
    <SolidColorBrush x:Key="AppDefaultButtonBrush" Color="#2C303B"/>
    <SolidColorBrush x:Key="AppDefaultButtonHoverBrush" Color="#363D4B"/>
    <SolidColorBrush x:Key="AppDefaultButtonPressedBrush" Color="#404A5C"/>
    <SolidColorBrush x:Key="AppDefaultButtonBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="AppDefaultButtonHoverBorderBrush" Color="#4C6F93"/>

    <!-- Primary CTA -->
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FBB040"/>
    <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#E6FBB040"/>
    <SolidColorBrush x:Key="AppPrimaryForegroundBrush" Color="#163546"/>

    <!-- Secondary CTA -->
    <SolidColorBrush x:Key="AppSecondaryBrush" Color="#4B5C62"/>
    <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#405561"/>
    <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#FFFFFF"/>

    <!-- Tertiary CTA -->
    <SolidColorBrush x:Key="AppTertiaryBrush" Color="#0B6BCB"/>
    <SolidColorBrush x:Key="AppTertiaryHoverBrush" Color="#143A56"/>
    <SolidColorBrush x:Key="AppTertiaryForegroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>