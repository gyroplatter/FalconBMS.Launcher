<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared theme styles.
        Actual brush values are supplied by Theme.Light.xaml or Theme.Dark.xaml.
    -->

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>
    
     <!-- Typography: Heading -->
    <Style x:Key="HeadingTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppHeadingForegroundBrush}"/>
    </Style>

    <!-- Typography: Subheading -->
    <Style x:Key="SubheadingTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppSubHeadingForegroundBrush}"/>
    </Style>

    <!-- Typography: Body -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppBodyForegroundBrush}"/>
    </Style>

    <!-- Typography: Muted -->
    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}"/>
    </Style>

    <!-- Controls table: shared DataGrid styling. Brush values come from the active light/dark theme. -->
    <Style x:Key="ControlsTableColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ControlsTableHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlsTableGridLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ControlsTableRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Style.Triggers>
            <!-- Non-editable and REM rows read like visible comments, not disabled content. -->
            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                <Setter Property="Background" Value="{DynamicResource ControlsTableCommentBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableCommentForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsRemark}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlsTableCommentBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableCommentForegroundBrush}"/>
            </DataTrigger>

            <!-- Axis rows use the same base row color as normal keyboard rows. -->
            <DataTrigger Binding="{Binding IsAxisRow}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            </DataTrigger>

            <!-- Subsection = H2 level inside the control list. -->
            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlsTableSubsectionBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableSubsectionForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="26"/>
            </DataTrigger>

            <!-- Section = H1 level inside the control list. -->
            <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlsTableSectionBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableSectionForegroundBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="MinHeight" Value="30"/>
            </DataTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlsTableHoverBrush}"/>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlsTableSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ControlsTableCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlsTableGridLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="Normal"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlsTableCommentForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsRemark}" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlsTableCommentForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsAxisRow}" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlsTableSubsectionForegroundBrush}"/>
                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlsTableSectionForegroundBrush}"/>
                <Setter Property="TextElement.FontWeight" Value="Bold"/>
            </DataTrigger>

            <!-- Keep the selected row color controlled by the row instead of WPF's default blue cell fill. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlsTableGridLineBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ControlsTableTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableCommentForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsRemark}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableCommentForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsAxisRow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableSubsectionForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ControlsTableSectionForegroundBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                <Setter Property="Margin" Value="8,0"/>
                <Setter Property="FontSize" Value="13.5"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                <Setter Property="Margin" Value="8,0"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsRemark}" Value="True">
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsAxisRow}" Value="True">
                <Setter Property="FontStyle" Value="Normal"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                <Setter Property="FontStyle" Value="Normal"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                <Setter Property="FontStyle" Value="Normal"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ControlsTableAxisBadgeStyle" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Background" Value="{DynamicResource ControlsTableAxisBadgeBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlsTableAxisBadgeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAxisRow}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ControlsTableAxisBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="Axis"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlsTableAxisBadgeForegroundBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ControlsTableStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlsTableGridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ControlsTableColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource ControlsTableRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ControlsTableCellStyle}"/>
    </Style>

    <Style TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Style.Triggers>
            <!-- Focus = match accent behavior -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Selected item area -->
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="10,4,32,4"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  RecognizesAccessKey="True"/>

                                <!-- Dropdown arrow area -->
                                <Path x:Name="Arrow"
                                      Width="10"
                                      Height="6"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Fill="{DynamicResource AppForegroundBrush}"
                                      Data="M 0 0 L 10 0 L 5 6 Z"/>
                            </Grid>
                        </Border>

                        <ToggleButton x:Name="ToggleButton"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide">
                            <Border x:Name="PopupBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="0"
                                              SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Opacity" Value="0.96"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover/selection use the alt surface brush instead of WPF's default blue highlight -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
    </Style>

    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!--
            Force CTA text to render through a TextBlock that always uses the
            primary foreground brush, instead of relying on WPF's default
            string-content rendering path.
        -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{DynamicResource AppPrimaryForegroundBrush}"
                               FontWeight="SemiBold"
                               FontFamily="Arial"
                               TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover = darker solid shade, not faded text -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}"/>
                        </Trigger>

                        <!-- Pressed = keep same darker shade for now -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AppPrimaryHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource AppSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!--
            Force CTA text to render through a TextBlock that always uses the
            secondary foreground brush, instead of relying on WPF's default
            string-content rendering path.
        -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{DynamicResource AppSecondaryForegroundBrush}"
                               FontWeight="SemiBold"
                               FontFamily="Arial"
                               TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover = darker solid shade, not faded text -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppSecondaryHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AppSecondaryHoverBrush}"/>
                        </Trigger>

                        <!-- Pressed = keep same darker shade for now -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AppSecondaryHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AppSecondaryHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Layout: Main content container
        Controls spacing for the primary content area (all tabs).
        Keep this as a named style (NOT global) to avoid affecting nested ContentControls.
    -->
    <Style x:Key="MainContentControlStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="16,12,16,12"/>
    </Style>
    
</ResourceDictionary>