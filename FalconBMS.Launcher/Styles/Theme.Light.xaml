<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light mode -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#E8EEF6"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#C6D1DF"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#18212C"/>
    <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#6b848c"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#3E6FA8"/>
    <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#1E232E"/>

    <SolidColorBrush x:Key="AppHeadingForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AppSubHeadingForegroundBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="AppBodyForegroundBrush" Color="#4B5563"/>

    <!-- Primary CTA -->
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FBB040"/>
    <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#E6FBB040"/>
    <SolidColorBrush x:Key="AppPrimaryForegroundBrush" Color="#163546"/>

    <!-- Secondary CTA -->
    <SolidColorBrush x:Key="AppSecondaryBrush" Color="#4B5C62"/>
    <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#E64B5C62"/>
    <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>