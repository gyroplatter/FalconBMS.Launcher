<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light mode -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F0F2F9"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#C6D1DF"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#18212C"/>
    <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#6B848C"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#3E6FA8"/>
    <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#1E232E"/>
    <SolidColorBrush x:Key="AppModalOverlayBrush" Color="#99000000"/>

    <!-- Header/body separator line -->
    <SolidColorBrush x:Key="AppHeaderSeparatorBrush" Color="#2F8DF2"/>

    <!-- Launch panel background -->
    <SolidColorBrush x:Key="LaunchDashboardCardBrush" Color="#EEF6FF"/>
    <SolidColorBrush x:Key="LaunchDashboardCardBorderBrush" Color="#AFC8E8"/>

    <!-- Used by DialogCardStyle -->
    <SolidColorBrush x:Key="AppDialogCardBorderBrush" Color="#33384A"/>
    <SolidColorBrush x:Key="AppDialogCardSurfaceBrush" Color="#F2FFFFFF"/>

    <LinearGradientBrush x:Key="AppDialogCardAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#3E6FA8"/>
        <GradientStop Offset="1" Color="#9FB6CC"/>
    </LinearGradientBrush>

    <!-- Warning text color used for overwrite/conflict warnings -->
    <SolidColorBrush x:Key="AppWarningTextBrush" Color="#B42318"/>

    <!-- Controls table -->
    <SolidColorBrush x:Key="ControlsTableHeaderBrush" Color="#F7FAFD"/>
    <SolidColorBrush x:Key="ControlsTableGridLineBrush" Color="#D8E2EF"/>

    <!-- Editable-row hover -->
    <SolidColorBrush x:Key="ControlsTableHoverBrush" Color="#F1F3F5"/>

    <!-- Active/selected row -->
    <SolidColorBrush x:Key="ControlsTableSelectedBrush" Color="#FFE7BA"/>

    <!-- Section heading -->
    <SolidColorBrush x:Key="ControlsTableSectionBackgroundBrush" Color="#C9DDED"/>
    <SolidColorBrush x:Key="ControlsTableSectionForegroundBrush" Color="#0F2F45"/>

    <!-- Subheading -->
    <SolidColorBrush x:Key="ControlsTableSubsectionBackgroundBrush" Color="#E5EDF5"/>
    <SolidColorBrush x:Key="ControlsTableSubsectionForegroundBrush" Color="#263F55"/>

    <SolidColorBrush x:Key="ControlsTableAxisBackgroundBrush" Color="#F5FAFF"/>
    <SolidColorBrush x:Key="ControlsTableCommentBackgroundBrush" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="ControlsTableCommentForegroundBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="ControlsTableOfflineDeviceBackgroundBrush" Color="#F3F4F6"/>

    <SolidColorBrush x:Key="ControlsTableAxisBadgeBackgroundBrush" Color="#D7E8FA"/>
    <SolidColorBrush x:Key="ControlsTableAxisBadgeForegroundBrush" Color="#143A56"/>
    <SolidColorBrush x:Key="ControlsTableAxisBadgeBorderBrush" Color="#A9C8E8"/>

    <SolidColorBrush x:Key="AppHeadingForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AppSubHeadingForegroundBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="AppBodyForegroundBrush" Color="#4B5563"/>
    
    <!-- Checkbox -->
    <SolidColorBrush x:Key="AppCheckBoxBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppCheckBoxBorderBrush" Color="#8AA5C2"/>
    <SolidColorBrush x:Key="AppCheckBoxHoverBorderBrush" Color="#0B6BCB"/>
    <SolidColorBrush x:Key="AppCheckBoxCheckedBrush" Color="#0B6BCB"/>
    <SolidColorBrush x:Key="AppCheckBoxCheckBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppCheckBoxDisabledBackgroundBrush" Color="#E1E6EC"/>
    <SolidColorBrush x:Key="AppCheckBoxDisabledBorderBrush" Color="#C5CED8"/>
    <SolidColorBrush x:Key="AppCheckBoxDisabledCheckBrush" Color="#7F8B98"/>

    <!-- Default button -->
    <SolidColorBrush x:Key="AppDefaultButtonBrush" Color="#E1E8F2"/> 
    <SolidColorBrush x:Key="AppDefaultButtonHoverBrush" Color="#F0F2F9"/>
    <SolidColorBrush x:Key="AppDefaultButtonPressedBrush" Color="#D4DEEA"/>
    <SolidColorBrush x:Key="AppDefaultButtonBorderBrush" Color="#C6D1DF"/>
    <SolidColorBrush x:Key="AppDefaultButtonHoverBorderBrush" Color="#9FB2C8"/>

    <!-- Primary CTA -->
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FBB040"/>
    <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#F79605"/>
    <SolidColorBrush x:Key="AppPrimaryForegroundBrush" Color="#163546"/>

    <!-- Secondary CTA -->
    <SolidColorBrush x:Key="AppSecondaryBrush" Color="#4B5C62"/>
    <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#405561"/>
    <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#FFFFFF"/>

    <!-- Tertiary CTA -->
    <SolidColorBrush x:Key="AppTertiaryBrush" Color="#0B6BCB"/>
    <SolidColorBrush x:Key="AppTertiaryHoverBrush" Color="#143A56"/>
    <SolidColorBrush x:Key="AppTertiaryForegroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>